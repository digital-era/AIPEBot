#@title 模型多因子分析
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
from scipy import stats

warnings.filterwarnings('ignore')
plt.rcParams['font.sans-serif'] = ['DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

# ==============================================
# 1. 数据准备：将 rank_df 与 df_combined 特征合并
# ==============================================
print("Step 1: Merge features...")

# 确保 df_combined 日期和代码格式
df_combined['日期'] = pd.to_datetime(df_combined['日期']).dt.normalize()
df_combined['代码'] = df_combined['代码'].astype(str).str.zfill(6)

# rank_df 中的 '中心日期' 已经是 Timestamp，'代码' 已为6位字符串
rank_df['中心日期'] = pd.to_datetime(rank_df['中心日期'])
rank_df['代码'] = rank_df['代码'].astype(str).str.zfill(6)

# 从 df_combined 中提取每个 (日期, 代码) 对应的特征
feature_cols = [
    '代码', '日期', 'PotScore', '总净流入占比_5日总和',
    '主力净流入-净占比', '超大单净流入-净占比',
    '涨跌幅', '收盘价'
]
df_features = df_combined[feature_cols].copy()

# 合并 rank_df 与特征
merged_df = rank_df.merge(
    df_features,
    left_on=['中心日期', '代码'],
    right_on=['日期', '代码'],
    how='left',
    suffixes=('', '_model')
)

# 检查合并后是否有缺失
print(f"Total records in rank_df: {len(rank_df)}")
print(f"Records after merge: {len(merged_df)}")
print(f"Missing PotScore: {merged_df['PotScore'].isna().sum()}")
print(f"Missing 总净流入占比_5日总和: {merged_df['总净流入占比_5日总和'].isna().sum()}")

# 删除无法匹配特征的行（如有）
merged_df = merged_df.dropna(subset=['PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比'])
print(f"Records after dropping missing features: {len(merged_df)}")

# ==============================================
# 2. 单因子分析：特征与10日收益的关系
# ==============================================
print("\nStep 2: Single factor analysis...")

def factor_analysis(df, factor, target='10天涨跌幅(%)', bins=5):
    """将因子分箱，计算每组的平均收益和胜率"""
    df_temp = df.copy()
    # 按分位数分组
    df_temp['factor_bin'] = pd.qcut(df_temp[factor], q=bins, duplicates='drop')
    grouped = df_temp.groupby('factor_bin', observed=False).agg(
        count=(target, 'count'),
        mean_return=(target, 'mean'),
        median_return=(target, 'median'),
        win_rate=(target, lambda x: (x > 0).mean() * 100)
    ).reset_index()
    return grouped

for factor in ['PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']:
    print(f"\n--- Factor: {factor} ---")
    result = factor_analysis(merged_df, factor)
    print(result.round(2))

# ==============================================
# 3. 过滤阈值优化（网格搜索）
# ==============================================
print("\nStep 3: Threshold optimization for filters...")

# 定义候选过滤条件范围
potscore_thresholds = [0.3, 0.5, 0.7, 1.0]
flow_5day_thresholds = [50, 60, 70, 80]
main_flow_thresholds = [0, 1, 2, 3]  # 主力净流入占比下限
super_flow_thresholds = [-5, -2, 0, 2]  # 超大单净流入占比下限

best_score = -np.inf
best_params = {}
results_list = []

for pot_th in potscore_thresholds:
    for flow_th in flow_5day_thresholds:
        for main_th in main_flow_thresholds:
            for super_th in super_flow_thresholds:
                # 应用过滤条件
                filtered = merged_df[
                    (merged_df['PotScore'] >= pot_th) &
                    (merged_df['总净流入占比_5日总和'] >= flow_th) &
                    (merged_df['主力净流入-净占比'] >= main_th) &
                    (merged_df['超大单净流入-净占比'] >= super_th)
                ]
                
                if len(filtered) < 20:  # 样本太少不可靠
                    continue
                
                mean_ret = filtered['10天涨跌幅(%)'].mean()
                win_rate = (filtered['10天涨跌幅(%)'] > 0).mean() * 100
                std_ret = filtered['10天涨跌幅(%)'].std()
                # 简单评价：夏普比率（假设无风险利率为0）
                sharpe = mean_ret / std_ret if std_ret > 0 else 0
                
                results_list.append({
                    'PotScore_min': pot_th,
                    'Flow5_min': flow_th,
                    'MainFlow_min': main_th,
                    'SuperFlow_min': super_th,
                    'n_samples': len(filtered),
                    'mean_return': mean_ret,
                    'win_rate': win_rate,
                    'std': std_ret,
                    'sharpe': sharpe
                })
                
                # 更新最优参数（以夏普比率为标准）
                if sharpe > best_score and len(filtered) >= 50:
                    best_score = sharpe
                    best_params = {
                        'pot_th': pot_th,
                        'flow_th': flow_th,
                        'main_th': main_th,
                        'super_th': super_th,
                        'n_samples': len(filtered),
                        'mean_ret': mean_ret,
                        'win_rate': win_rate,
                        'sharpe': sharpe
                    }

results_grid = pd.DataFrame(results_list).sort_values('sharpe', ascending=False)
print("Top 10 parameter combinations by Sharpe ratio:")
print(results_grid.head(10))

print("\nBest parameters (with at least 50 samples):")
print(best_params)

# ==============================================
# 4. 基于最优过滤条件构建打分模型（可选）
# ==============================================
print("\nStep 4: Build scoring model...")

# 使用最优参数过滤
best_filtered = merged_df[
    (merged_df['PotScore'] >= best_params['pot_th']) &
    (merged_df['总净流入占比_5日总和'] >= best_params['flow_th']) &
    (merged_df['主力净流入-净占比'] >= best_params['main_th']) &
    (merged_df['超大单净流入-净占比'] >= best_params['super_th'])
].copy()

print(f"Samples after best filter: {len(best_filtered)}")

# 特征标准化
from sklearn.preprocessing import StandardScaler

scoring_features = ['PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']
scaler = StandardScaler()
best_filtered[scoring_features] = scaler.fit_transform(best_filtered[scoring_features])

# 简单加权打分（权重可调）
weights = {
    'PotScore': 0.4,
    '总净流入占比_5日总和': 0.3,
    '主力净流入-净占比': 0.2,
    '超大单净流入-净占比': 0.1
}
best_filtered['Score'] = sum(best_filtered[col] * w for col, w in weights.items())

# 验证打分排序的有效性：高分组的收益是否更高
best_filtered['score_bin'] = pd.qcut(best_filtered['Score'], q=5, duplicates='drop')
score_grouped = best_filtered.groupby('score_bin', observed=False)['10天涨跌幅(%)'].agg(['mean', 'std', 'count'])
score_grouped['win_rate'] = best_filtered.groupby('score_bin', observed=False)['10天涨跌幅(%)'].apply(lambda x: (x>0).mean()*100)
print("\nReturns by score quintile:")
print(score_grouped.round(2))

# ==============================================
# Step 5 (修正版)：固定调仓周期回测
# ==============================================
print("\nStep 5 (Fixed Rebalance Period): Backtest...")

# 使用最优过滤条件后的样本 best_filtered
backtest_df = best_filtered.copy()

# 按中心日期排序
backtest_df = backtest_df.sort_values('中心日期')

# 获取所有唯一的调仓日期（信号日期）
all_dates = sorted(backtest_df['中心日期'].unique())

# 设定调仓周期为10个交易日
REBALANCE_PERIOD = 10
selected_dates = all_dates[::REBALANCE_PERIOD]  # 每隔10个交易日选股一次

# 对于每个调仓日，选择打分最高的3只股票，等权持有10个交易日
portfolio_returns = []

for i, date in enumerate(selected_dates):
    # 当日信号
    day_data = backtest_df[backtest_df['中心日期'] == date]
    if day_data.empty:
        continue
    
    # 选择打分最高的3只
    top_stocks = day_data.nlargest(3, 'Score')
    
    # 获取这3只股票从该日期开始的未来10个交易日的收益（已经在 rank_df 中为10天涨跌幅）
    # 注意：这里的收益代表持有10个交易日后的总收益
    period_return = top_stocks['10天涨跌幅(%)'].mean()
    portfolio_returns.append({
        '调仓日期': date,
        '10日组合收益(%)': period_return,
        '持仓股票': list(top_stocks['代码'])
    })

# 转换为 DataFrame
period_df = pd.DataFrame(portfolio_returns)

# 计算净值（每期收益累乘）
period_df['净值'] = (1 + period_df['10日组合收益(%)'] / 100).cumprod()

# 输出结果
print(f"调仓期数: {len(period_df)}")
print(f"总收益率: {(period_df['净值'].iloc[-1] - 1) * 100:.2f}%")
print(f"年化收益率: {((period_df['净值'].iloc[-1]) ** (252 / (len(period_df) * REBALANCE_PERIOD)) - 1) * 100:.2f}%")
print(f"最大回撤: {((period_df['净值'] / period_df['净值'].cummax()) - 1).min() * 100:.2f}%")
print(f"夏普比率(每期): {period_df['10日组合收益(%)'].mean() / period_df['10日组合收益(%)'].std() * np.sqrt(252/REBALANCE_PERIOD):.2f}")

# 可视化净值曲线
plt.figure(figsize=(10,6))
plt.plot(period_df['调仓日期'], period_df['净值'], marker='o')
plt.title('Portfolio Net Value (Fixed 10-day Rebalance)')
plt.xlabel('Rebalance Date')
plt.ylabel('Net Value')
plt.grid(True)
plt.show()

