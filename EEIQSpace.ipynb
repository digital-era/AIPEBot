        'daily_change_upper': 10,
        'five_day_upper': 40,
        'ten_day_upper': 50,
        'rsi_upper': 85,
        'bias_upper': 25
    },
    {   # 不限制时机（仅基础过滤）
        'daily_change_upper': np.inf,
        'five_day_upper': np.inf,
        'ten_day_upper': np.inf,
        'rsi_upper': np.inf,
        'bias_upper': np.inf
    }
]

weights = {
    'PotScore': 0.4,
    '总净流入占比_5日总和': 0.3,
    '主力净流入-净占比': 0.2,
    '超大单净流入-净占比': 0.1
}

def compute_technical_indicators(df):
    df = df.sort_values(['代码','日期']).copy()
    df['5日累计涨幅'] = df.groupby('代码')['收盘价'].pct_change(5) * 100
    df['10日累计涨幅'] = df.groupby('代码')['收盘价'].pct_change(10) * 100
    def rsi(series, period=14):
        delta = series.diff()
        gain = delta.clip(lower=0)
        loss = -delta.clip(upper=0)
        avg_gain = gain.rolling(window=period, min_periods=period).mean()
        avg_loss = loss.rolling(window=period, min_periods=period).mean()
        rs = avg_gain / avg_loss.replace(0, np.nan)
        rsi = 100 - (100 / (1 + rs))
        return rsi
    df['RSI14'] = df.groupby('代码')['收盘价'].transform(lambda x: rsi(x))
    df['MA20'] = df.groupby('代码')['收盘价'].rolling(20).mean().reset_index(level=0, drop=True)
    df['BIAS20'] = (df['收盘价'] / df['MA20'] - 1) * 100
    return df

if 'df_combined_tech' in globals():
    df_combined_tech = df_combined_tech
else:
    df_combined_tech = compute_technical_indicators(df_combined)

latest_date = df_combined_tech['日期'].max()
latest_data = df_combined_tech[df_combined_tech['日期'] == latest_date].copy()

# 尝试不同时机过滤
selected_filter = None
for timing in timing_filters:
    filter_params = {**base_params, **timing}
    temp_filtered = latest_data[
        (latest_data['PotScore'] >= filter_params['pot_th']) &
        (latest_data['总净流入占比_5日总和'] >= filter_params['flow_th']) &
        (latest_data['主力净流入-净占比'] >= filter_params['main_th']) &
        (latest_data['超大单净流入-净占比'] >= filter_params['super_th']) &
        (latest_data['涨跌幅'] <= filter_params['daily_change_upper']) &
        (latest_data['5日累计涨幅'] <= filter_params['five_day_upper']) &
        (latest_data['10日累计涨幅'] <= filter_params['ten_day_upper']) &
        (latest_data['RSI14'] <= filter_params['rsi_upper']) &
        (latest_data['BIAS20'] <= filter_params['bias_upper'])
    ].dropna(subset=['PotScore', '总净流入占比_5日总和', 
                     '主力净流入-净占比', '超大单净流入-净占比'])
    
    if len(temp_filtered) >= 3:
        selected_filter = filter_params
        latest_filtered = temp_filtered
        print(f"使用时机过滤：{timing}")
        print(f"通过过滤的股票数量：{len(latest_filtered)}")
        break

if selected_filter is None:
    # 极端情况：所有过滤都不足3只，使用基础过滤并取所有股票
    selected_filter = base_params
    latest_filtered = latest_data[
        (latest_data['PotScore'] >= base_params['pot_th']) &
        (latest_data['总净流入占比_5日总和'] >= base_params['flow_th']) &
        (latest_data['主力净流入-净占比'] >= base_params['main_th']) &
        (latest_data['超大单净流入-净占比'] >= base_params['super_th'])
    ].dropna(subset=['PotScore', '总净流入占比_5日总和', 
                     '主力净流入-净占比', '超大单净流入-净占比'])
    print(f"基础过滤后仅{len(latest_filtered)}只，不进行时机过滤。")

if latest_filtered.empty:
    print("基础过滤下也无股票，建议空仓。")
else:
    # 标准化与打分
    historical_filtered = df_combined_tech[
        (df_combined_tech['PotScore'] >= base_params['pot_th']) &
        (df_combined_tech['总净流入占比_5日总和'] >= base_params['flow_th']) &
        (df_combined_tech['主力净流入-净占比'] >= base_params['main_th']) &
        (df_combined_tech['超大单净流入-净占比'] >= base_params['super_th'])
    ].dropna(subset=['PotScore', '总净流入占比_5日总和', 
                     '主力净流入-净占比', '超大单净流入-净占比'])
    
    scaler = StandardScaler()
    scoring_features = ['PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']
    scaler.fit(historical_filtered[scoring_features])
    
    latest_filtered[scoring_features] = scaler.transform(latest_filtered[scoring_features])
    latest_filtered['Score'] = sum(latest_filtered[col] * w for col, w in weights.items())
    latest_filtered = latest_filtered.sort_values('Score', ascending=False)
    
    N = min(3, len(latest_filtered))
    top_picks = latest_filtered.head(N)
