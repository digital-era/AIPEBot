# 确保 df_combined 已加载，且包含所需列
required_cols = ['代码', '名称', '日期', '收盘价', '涨跌幅', 'PotScore',
                 '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']
for col in required_cols:
