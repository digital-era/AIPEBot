#@title 模型10日窗口数据计算

import pandas as pd
import numpy as np
from datetime import date

# ========== 参数设置 ==========
WINDOW_LEFT = 5
WINDOW_RIGHT = 5
STRICT_MODE = True   # True: 必须前后各5个交易日；False: 使用可用窗口

# ========== 前置检查与格式统一 ==========
print("===== 初始检查 =====")
print(f"unique_date_code_pairs 数量: {len(unique_date_code_pairs)}")
print(f"df_combined 形状: {df_combined.shape}")

# 确保列存在
required_cols = ['代码', '日期', '收盘价']
for col in required_cols:
    if col not in df_combined.columns:
        raise ValueError(f"df_combined 缺少列: {col}")

# 统一 df_combined 的日期和代码格式
df_combined['日期'] = pd.to_datetime(df_combined['日期']).dt.normalize()
df_combined['代码'] = df_combined['代码'].astype(str).str.strip().str.zfill(6)

# 构造标准化的 pairs 列表，日期转为 Timestamp 并归一化
pairs = []
for d, c in unique_date_code_pairs:
    try:
        date_ts = pd.to_datetime(d).normalize()
        code_str = str(c).strip().zfill(6)
        pairs.append((date_ts, code_str))
    except Exception as e:
        print(f"忽略无效对 ({d}, {c}): {e}")

print(f"有效日期-代码对数量: {len(pairs)}")

# ========== 计算10日涨跌幅 ==========
results = []
skipped_no_date = 0
skipped_boundary = 0
skipped_zero_price = 0

# 按代码分组，提前排序并缓存
grouped = df_combined.groupby('代码', sort=False)

for code, group in grouped:
    # 按日期排序
    group_sorted = group.sort_values('日期')
    
    # 关键修改：将日期转换为 Python date 对象，避免哈希不一致
    dates = group_sorted['日期'].dt.date.values   # datetime.date 数组
    closes = group_sorted['收盘价'].values
    
    # 建立 date -> 索引 的映射
    pos_map = {d: i for i, d in enumerate(dates)}
    
    # 当前股票对应的 (center_date, code) 对
    code_pairs = [(d, c) for d, c in pairs if c == code]
    
    for center_date_ts, c in code_pairs:
        # 将 center_date_ts 也转为 date 对象
        center_date = center_date_ts.date()
        
        if center_date not in pos_map:
            skipped_no_date += 1
            continue
        
        center_idx = pos_map[center_date]
        left_idx = center_idx - WINDOW_LEFT
        right_idx = center_idx + WINDOW_RIGHT
        
        if STRICT_MODE:
            if left_idx < 0 or right_idx >= len(group_sorted):
                skipped_boundary += 1
                continue
        else:
            left_idx = max(0, left_idx)
            right_idx = min(len(group_sorted) - 1, right_idx)
            if right_idx - left_idx < 2:
                skipped_boundary += 1
                continue
        
        start_date = dates[left_idx]
        end_date = dates[right_idx]
        start_close = closes[left_idx]
        end_close = closes[right_idx]
        
        if start_close == 0 or end_close == 0 or np.isnan(start_close) or np.isnan(end_close):
            skipped_zero_price += 1
            continue
        
        ret_10d = (end_close / start_close - 1) * 100
        
        results.append({
            '中心日期': center_date_ts,   # 保留 Timestamp 便于后续处理
            '代码': c,
            '开始日期': pd.Timestamp(start_date),
            '结束日期': pd.Timestamp(end_date),
            '开始收盘价': start_close,
            '结束收盘价': end_close,
            '窗口交易日数': right_idx - left_idx + 1,
            '10天涨跌幅(%)': round(ret_10d, 2)
        })

# ========== 诊断输出 ==========
print("\n===== 计算诊断 =====")
print(f"总对数: {len(pairs)}")
print(f"成功计算: {len(results)}")
print(f"因中心日期无数据跳过: {skipped_no_date}")
print(f"因窗口边界不足跳过: {skipped_boundary}")
print(f"因价格为零或缺失跳过: {skipped_zero_price}")

# ========== 生成结果 DataFrame ==========
if results:
    rank_df = pd.DataFrame(results)
    rank_df = rank_df.sort_values('10天涨跌幅(%)', ascending=False).reset_index(drop=True)
    rank_df.insert(0, '排名', rank_df.index + 1)
else:
    rank_df = pd.DataFrame(columns=[
        '排名', '中心日期', '代码', '开始日期', '结束日期',
        '开始收盘价', '结束收盘价', '窗口交易日数', '10天涨跌幅(%)'
    ])
    print("\n警告：没有有效记录，返回空 DataFrame。")

