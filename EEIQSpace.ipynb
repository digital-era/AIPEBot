            "主力净流入-净占比(%)": f"{float(row['主力净流入-净占比']):.2f}%",
            "超大单净流入-净占比(%)": f"{float(row['超大单净流入-净占比']):.2f}%"
        }
        config_details.append(detail)
    
    # 其余 JSON 部分同前，此处省略，请参考完整版
    
    print(f"\n最终推荐组合（前{N}只）：")
