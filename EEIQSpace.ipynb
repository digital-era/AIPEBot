    (latest_data['主力净流入-净占比'] >= best_params['main_th']) &
    (latest_data['超大单净流入-净占比'] >= best_params['super_th'])
].copy()

if latest_filtered.empty:
    raise ValueError("最新交易日无股票通过过滤条件，无法生成组合。")

# 标准化与打分（使用历史过滤样本拟合标准化器）
filtered_hist = df_combined[
    (df_combined['PotScore'] >= best_params['pot_th']) &
    (df_combined['总净流入占比_5日总和'] >= best_params['flow_th']) &
    (df_combined['主力净流入-净占比'] >= best_params['main_th']) &
