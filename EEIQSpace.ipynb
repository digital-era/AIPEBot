#@title EEIQModel 初始化数据获取 (防超时优化版)
import pandas as pd
import numpy as np
import os
import re
import warnings
import gc
import lightgbm as lgb
from sklearn.metrics import classification_report
from tqdm.auto import tqdm
from joblib import Parallel, delayed
from multiprocessing import cpu_count
from datetime import timedelta, datetime
import threading
import time

# --- 1. 定义防超时心跳机制 ---
# 标志位，控制心跳线程是否运行
keep_alive_active = True

def keep_alive_worker(interval=45):
    """
    后台线程函数：定期打印时间戳，防止Colab因主线程阻塞（如读大文件）无输出而断开。
    """
    while keep_alive_active:
        # 打印心跳包
        timestamp = datetime.now().strftime('%H:%M:%S')
        print(f"💓 [Colab保活] 系统正在处理中，请勿关闭... ({timestamp})")
        # 休眠指定时间
        time.sleep(interval)

# 启动心跳线程的辅助函数
def start_keep_alive():
    global keep_alive_active
    keep_alive_active = True
    t = threading.Thread(target=keep_alive_worker, args=(45,)) # 每45秒打印一次
    t.daemon = True # 设置为守护线程，主程序退出它也退出
    t.start()
    return t

def stop_keep_alive():
    global keep_alive_active
    keep_alive_active = False

# --- 2. 原有日志函数 ---
def log_message(message):
    """打印带有时间戳的日志信息。"""
    print(f"[{datetime.now().strftime('%Y-%m-%d %H:%M:%S')}] {message}")

# 忽略所有警告信息
warnings.filterwarnings("ignore")
tqdm.pandas()

# ==========================================
# 主程序开始
# ==========================================

# 启动心跳线程
heartbeat_thread = start_keep_alive()
log_message("--- 任务开始：EEIQModel 初始化数据获取 (已启动后台保活线程) ---")

try:
    # --- 3. 定义数据目录和文件模式 ---
    DATA_DIR = "/content/AIPEQModel/data/"
    FILE_PREFIX = "EEIFlow"
    FILE_SUFFIX = ".xlsx"
    SHEET_NAME = "Flow5DaysSort"

    # 要删除的文件名列表
    to_remove = [
        "EEIFlowAll.xlsx",
        "EEIFlowETF.xlsx",
        "EEIFlowHK.xlsx"
    ]

    removed_files = []

    # --- 4. 加载所有附件数据 (并行优化)---
    def load_data_file(filename):
        """加载单个Excel文件，支持多个sheet名称备选项。"""
        filepath = os.path.join(DATA_DIR, filename)
        try:
            # 读取 Excel 是最耗时的操作之一
            return pd.read_excel(filepath, sheet_name=SHEET_NAME, engine='openpyxl')
        except:
            try:
                return pd.read_excel(filepath, sheet_name=0, engine='openpyxl')
            except Exception as e:
                # 错误信息简短打印，避免刷屏
                return None

    # 自然排序函数
    def natural_sort_key(s):
        return [int(text) if text.isdigit() else text.lower()
                for text in re.split('([0-9]+)', s)]

    log_message("步骤 1: 扫描数据目录并准备文件列表...")
    matching_files = []
    removed_files =[]

    if os.path.exists(DATA_DIR):
      file_n_map = {}
      for file in os.listdir(DATA_DIR):
          # 正则匹配 'EEIFlow' 开头，'.xlsx' 结尾，提取中间部分
          match = re.fullmatch(r"EEIFlow(.*)\.xlsx", file)
          if match:
              n_str = match.group(1)
              if n_str == "":
                  file_n_map[file] = -1  # 用 -1 标识最基础的 EEIFlow.xlsx
              elif n_str.isdigit() and int(n_str) >= 1:
                  file_n_map[file] = int(n_str)
              else:
                  # N<1的数字或包含ETF, HK, All等字符的文件，分流到忽略列表
                  removed_files.append(file)

      # 找出最大N，并进行二次过滤
      if file_n_map:
          max_n = max(file_n_map.values())
          for file, n in file_n_map.items():
              ## 核心逻辑：保留 EEIFlow.xlsx (-1) 以及 N >= 最大N - 72 的文件
              ## if n == -1 or n >= max_n - 72:
              ## if n == -1 or n >= 1:
              if n == -1 or n >= max_n - 72:
                  matching_files.append(file)
              else:
                  removed_files.append(file)
    else:
      log_message(f"警告: 目录 {DATA_DIR} 不存在。")

    # 排序
    matching_files.sort(key=natural_sort_key)
    log_message(f"找到 {len(matching_files)} 个匹配的数据文件。根据限定条件已忽略文件: {removed_files}")

    if not matching_files:
        log_message(f"错误: 在目录 '{DATA_DIR}' 中未找到任何匹配 '{FILE_PREFIX}*.xlsx' 模式的文件。")
        # 这里不直接 exit，而是抛出异常以触发 finally 块停止心跳
        raise RuntimeError("没有找到数据文件，程序终止。")

    # 并行加载文件
    log_message(f"步骤 2: 开始并行加载 {len(matching_files)} 个文件（这可能需要一些时间）...")

    # 调整核心数，Colab 标准版通常只有2个核心，给系统留一点余地
    num_cores = min(4, cpu_count())

    # verbose=5 减少标准错误流的输出量，依赖我们的心跳线程来保活
    all_data_frames = Parallel(n_jobs=num_cores, verbose=5)(
        delayed(load_data_file)(filename) for filename in matching_files
    )
    log_message("并行加载任务完成。")

    # 过滤掉None值
    all_data_frames = [df for df in all_data_frames if df is not None]
    loaded_file_count = len(all_data_frames)

    if not all_data_frames:
        raise RuntimeError("所有文件加载失败，程序终止。")

    log_message(f"成功加载 {loaded_file_count} 个文件的数据。")

    log_message("步骤 3: 合并所有数据 (concat)...")
    # concat 也是内存密集型操作，容易卡顿
    df_combined = pd.concat(all_data_frames, ignore_index=True)
    log_message("数据合并完成。")

    # 立即释放内存
    del all_data_frames
    gc.collect()
    log_message("内存已释放。")

    log_message("步骤 4: 数据预处理...")
    log_message("格式化 '代码' 列...")
    if '代码' in df_combined.columns:
        df_combined['代码'] = df_combined['代码'].apply(
            lambda x: str(x).zfill(6) if pd.notna(x) else x
        )
    else:
        raise ValueError("数据中缺少 '代码' 列。")

    log_message("按 '代码' 和 '日期' 去重...")
    if '代码' in df_combined.columns and '日期' in df_combined.columns:
        initial_rows = len(df_combined)
        # ascending=[True, True, False] 表示：代码升序，日期升序，PotScore降序（优先保留分数高的）.na_position='last'都会强制把所有包含缺失值的行放到排序结果的最后面（即“沉底”）
        df_combined.sort_values(
            by=['代码', '日期', 'PotScore'],
            ascending=[True, False, False],
            na_position='last',
            inplace=True
        )
        df_combined.drop_duplicates(subset=['代码', '日期'], keep='first', inplace=True)
        final_rows = len(df_combined)
        log_message(f"去重完成。删除了 {initial_rows - final_rows} 行。")
    else:
        raise ValueError("数据中缺少 '代码' 或 '日期' 列。")

    # --- 5. 从本地Excel文件获取UDI特征 ---
    log_message("\n步骤 5: 加载市场特征数据 (UDI & GDI)...")

    def get_market_data_from_excel(sheet_name):
        prefix = "UDI_" if sheet_name == "UDI" else "GDI_"
        try:
            file_path = "/content/skfigure.xlsx"
            # 检查文件是否存在
            if not os.path.exists(file_path):
                log_message(f"  > 警告: 文件 {file_path} 不存在。")
                return pd.DataFrame()

            data = pd.read_excel(file_path, sheet_name=sheet_name, usecols=['Date', 'Close', 'Percent'])
            if data.empty: return pd.DataFrame()

            data = data.rename(columns={'Close': f'{prefix}Close', 'Percent': f'{prefix}Percent'})
            data['Date'] = pd.to_datetime(data['Date'], errors='coerce', utc=False)
            data = data.sort_values('Date', ascending=False).reset_index(drop=True)
            data['Date'] = data['Date'].dt.strftime('%Y-%m-%d')
            return data
        except Exception as e:
            log_message(f"  > 警告: 读取 '{sheet_name}' 出错: {e}")
            return pd.DataFrame()

    df_udi = get_market_data_from_excel("UDI")
    df_gdi = get_market_data_from_excel("GDI")

    # 合并市场数据
    log_message("\n步骤 6: 合并市场特征到主数据集...")
    df_combined['日期'] = pd.to_datetime(df_combined['日期'], errors='coerce')
    df_combined = df_combined.dropna(subset=['日期'])

    if not df_udi.empty:
        df_udi['Date'] = pd.to_datetime(df_udi['Date'])
        # merge 操作如果数据量大，会阻塞很久
        df_combined = pd.merge(df_combined, df_udi, left_on='日期', right_on='Date', how='left')
        df_combined = df_combined.drop(columns=['Date'], errors='ignore')
        log_message(f"UDI合并完成。")

    # 填充 UDI/GDI
    for col in ['UDI_Close', 'UDI_Percent']:
        if col in df_combined.columns:
            df_combined[col] = df_combined[col].fillna(method='ffill').fillna(method='bfill')
            if df_combined[col].isna().any():
                df_combined[col] = df_combined[col].fillna(df_combined[col].mean())

    # --- 7. 加载并合并行业标签 (l2name) ---
    log_message("\n步骤 7: 加载并合并行业标签 (l2name)...")
    target_file_path = "/content/EEITarget.xlsx"

    try:
        if os.path.exists(target_file_path):
            df_l2name = pd.read_excel(target_file_path, sheet_name="ARTop", usecols=['代码', 'l2name'], engine='openpyxl')
            df_l2name['代码'] = df_l2name['代码'].apply(lambda x: str(x).zfill(6) if pd.notna(x) else x)
            df_l2name.drop_duplicates(subset=['代码'], keep='first', inplace=True)

            df_combined = pd.merge(df_combined, df_l2name, on='代码', how='left')
            df_combined['l2name'].fillna('未知行业', inplace=True)
            log_message(f"l2name 合并完成。")
        else:
            log_message(f"警告: {target_file_path} 不存在，跳过 l2name 合并。")

    except Exception as e:
        log_message(f"l2name 处理出错: {e}")

    log_message("\n--- 数据初始化流程全部完成 ---")
    log_message(f"最终数据集大小: {df_combined.shape[0]} 行, {df_combined.shape[1]} 列。")

except Exception as e:
    log_message(f"❌ 程序执行过程中发生严重错误: {e}")
    # 打印堆栈以便调试
    import traceback
    traceback.print_exc()

finally:
    # ==========================================
    # 无论成功与否，都必须停止心跳线程，否则Cell永远不会结束
    # ==========================================
    stop_keep_alive()
    log_message("🏁 心跳线程已停止，Cell 执行结束。")



#@title 模型历史标的日期信息提取
import os
import json
import re
from datetime import datetime

base_dir = '/content/AIPEQModel'
#start_date = datetime(2026, 4, 29)
#end_date = datetime(2026, 8, 12)

start_date = df_combined['日期'].min()
end_date = df_combined['日期'].max()

# 匹配文件名：流入模型_YYYY-MM-DD.json
pattern = re.compile(r'^流入模型_(\d{4}-\d{2}-\d{2})\.json$')

# 保存所有“日期-代码”记录（不去重，按出现顺序）
date_code_records = []

# 保存每个日期下的代码列表
codes_by_date = {}

# 去重后的代码列表
all_codes = []
seen_codes = set()

# 去重后的“日期-代码”对（每个日期内代码本身不会重复，但跨日期会重复，这里按对去重）
seen_pairs = set()
unique_date_code_pairs = []

if not os.path.isdir(base_dir):
    print(f"目录不存在：{base_dir}")
else:
    fnames = sorted(os.listdir(base_dir))

    for fname in fnames:
        m = pattern.match(fname)
        if not m:
            continue

        date_str = m.group(1)
        try:
            date_obj = datetime.strptime(date_str, '%Y-%m-%d')
        except ValueError:
            continue

        if start_date <= date_obj <= end_date:
            path = os.path.join(base_dir, fname)

            try:
                with open(path, 'r', encoding='utf-8') as f:
                    data = json.load(f)

                details = (
                    data.get("结果", {})
                    .get("最优投资组合配置", {})
                    .get("配置详情", [])
                )

                day_codes = []

                for item in details:
                    if not isinstance(item, dict):
                        continue

                    raw_code = item.get("代码")
                    if raw_code is None:
                        continue

                    code = str(raw_code).strip()

                    # 确保是 6 位字符串代码
                    if code.isdigit():
                        code = code.zfill(6)
                    elif len(code) == 0:
                        continue
                    else:
                        print(f"  [警告] {fname} 中代码格式异常: {raw_code}")

                    day_codes.append(code)

                    # 记录日期-代码对
                    date_code_records.append((date_str, code))

                    # 去重后的代码
                    if code not in seen_codes:
                        seen_codes.add(code)
                        all_codes.append(code)

                    # 去重后的日期-代码对
                    pair = (date_str, code)
                    if pair not in seen_pairs:
                        seen_pairs.add(pair)
                        unique_date_code_pairs.append(pair)

                codes_by_date[date_str] = day_codes

            except Exception as e:
                print(f"{fname} 读取/解析失败: {e}")

    # ========== 输出 ==========

    print("===== 逐日代码列表 =====")
    for date_str in sorted(codes_by_date):
        print(f"{date_str}: {codes_by_date[date_str]}")

    print("\n===== 所有“日期-代码”记录（不去重，按文件顺序） =====")
    for d, c in date_code_records:
        print(f"{d}\t{c}")
    print(f"共 {len(date_code_records)} 条记录")

    print("\n===== 去重后的“日期-代码”对 =====")
    for d, c in unique_date_code_pairs:
        print(f"{d}\t{c}")
    print(f"共 {len(unique_date_code_pairs)} 条唯一日期-代码对")

    print("\n===== 去重后的标的代码列表 =====")
    print(all_codes)
    print(f"共 {len(all_codes)} 个")

    print("\n逗号分隔：")
    print(','.join(all_codes))



