scoring_features = ['PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']
latest_filtered[scoring_features] = scaler.transform(latest_filtered[scoring_features])
latest_filtered['Score'] = sum(latest_filtered[col] * w for col, w in weights.items())
latest_filtered = latest_filtered.sort_values('Score', ascending=False)

# 取前3只等权
N = 3
top_picks = latest_filtered.head(N)
weight_percent = round(100.0 / N, 2)  # 33.33

