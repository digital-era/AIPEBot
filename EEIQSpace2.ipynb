#@title 生成5日周期交易模型
import pandas as pd
import numpy as np
import json
from datetime import datetime

# ============================
# 1. 数据准备与参数
# ============================
if 'df_combined_tech' not in globals():
    raise ValueError("未找到 df_combined_tech，请先运行模型多因子分析计算技术指标。")

df = df_combined_tech.copy()
df['日期'] = pd.to_datetime(df['日期']).dt.normalize()
df['代码'] = df['代码'].astype(str).str.zfill(6)

# 基础过滤条件
base_params = {'pot_th': 1.0, 'flow_th': 80, 'main_th': 1, 'super_th': 0}

# 评分权重
weights = {'PotScore': 0.4, '总净流入占比_5日总和': 0.3,
           '主力净流入-净占比': 0.2, '超大单净流入-净占比': 0.1}
scoring_features = ['PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']

# ============================
# 2. 确定调仓日（每5个交易日）
# ============================
all_trading_days = sorted(df['日期'].unique())
REBALANCE_PERIOD = 5
rebalance_dates = all_trading_days[::REBALANCE_PERIOD]
print(f"调仓日数量: {len(rebalance_dates)}")

# 名称映射
name_map = {}
if '名称' in df.columns:
    name_map = df.drop_duplicates('代码').set_index('代码')['名称'].to_dict()

# ============================
# 3. 为每个调仓日生成选股结果（基础过滤+打分）
# ============================
plans = []

for rebalance_date in rebalance_dates:
    day_data = df[df['日期'] == rebalance_date].copy()
    if day_data.empty:
        continue

    # 基础过滤
    filtered = day_data[
        (day_data['PotScore'] >= base_params['pot_th']) &
        (day_data['总净流入占比_5日总和'] >= base_params['flow_th']) &
        (day_data['主力净流入-净占比'] >= base_params['main_th']) &
        (day_data['超大单净流入-净占比'] >= base_params['super_th'])
    ].dropna(subset=scoring_features)

    if filtered.empty:
        continue

    # 打分
    filtered['Score'] = (filtered['PotScore'] * 0.4 +
                         filtered['总净流入占比_5日总和'] * 0.3 +
                         filtered['主力净流入-净占比'] * 0.2 +
                         filtered['超大单净流入-净占比'] * 0.1)
    filtered = filtered.sort_values('Score', ascending=False)

    # 取前3只
    top_picks = filtered.head(3)
    if top_picks.empty:
        continue

    stocks_rules = []
    for _, stock in top_picks.iterrows():
        code = stock['代码']
        name = name_map.get(code, stock.get('名称', ''))
        stocks_rules.append({
            "代码": code,
            "名称": name,
            "买入规则": "第1天买入（调仓日次日开盘价）",
            "卖出规则": "第5天卖出（第5个交易日收盘价）"
        })

    plans.append({
        "调仓日期": rebalance_date.strftime('%Y-%m-%d'),
        "股票数量": len(stocks_rules),
        "股票明细": stocks_rules
    })

# ============================
# 4. 生成 JSON
# ============================
output = {
    "规则说明": f"每{REBALANCE_PERIOD}个交易日调仓一次，选取基础过滤后综合得分最高的3只股票。",
    "买入规则": "第1天买入（调仓日次日开盘价）",
    "卖出规则": "第5天卖出（第5个交易日收盘价）",
    "生成时间": datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
    "调仓周期数": len(plans),
    "交易计划": plans
}

with open('5日周期交易模型.json', 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f"交易计划已保存至 5日周期交易模型.json，共 {len(plans)} 个调仓周期")
print(json.dumps(output, ensure_ascii=False, indent=2)[:1000])


#@title 5日周期交易模型回测（BaoStock 5分钟数据）
import pandas as pd
import numpy as np
import json
import time
import subprocess
import sys
from datetime import datetime, timedelta

# ============================
# 导入 baostock
# ============================
try:
    import baostock as bs
except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "baostock", "-q"])
    import baostock as bs

# ============================
# 读取交易计划（5日周期）
# ============================
plan_file = '5日周期交易模型.json'
try:
    with open(plan_file, 'r', encoding='utf-8') as f:
        trade_plan_json = json.load(f)
except FileNotFoundError:
    raise FileNotFoundError(f"未找到 {plan_file}，请先运行生成5日周期交易模型的代码。")

plans = trade_plan_json['交易计划']
print(f"调仓周期数: {len(plans)}")

# ============================
# 准备日线数据（仅用于获取交易日列表）
# ============================
if 'df_combined' not in globals():
    raise ValueError("请先加载 df_combined（日线数据）")

df_daily = df_combined[['日期', '代码', '收盘价']].copy()
df_daily.columns = ['date', 'code', 'close']
df_daily['date'] = pd.to_datetime(df_daily['date'])
df_daily['code'] = df_daily['code'].astype(str).str.zfill(6)
df_daily = df_daily.sort_values(['code', 'date'])

# ============================
# BaoStock 5分钟数据获取函数（单日，含重试）
# ============================
def to_bs_code(code):
    code = str(code).zfill(6)
    return f"sh.{code}" if code.startswith('6') else f"sz.{code}"

def fetch_5min_by_date(code, date_str, retries=3, delay=1.5):
    bs_code = to_bs_code(code)
    for attempt in range(retries):
        rs = bs.query_history_k_data_plus(
            bs_code,
            "date,time,open,high,low,close,volume",
            start_date=date_str,
            end_date=date_str,
            frequency="5",
            adjustflag="3"
        )
        if rs.error_code == '0':
            data = rs.get_data()
            if len(data) > 0:
                df = pd.DataFrame(data, columns=rs.fields)
                df = df[df['date'].notna() & df['time'].notna()]
                def parse_time(row):
                    time_str = str(row['time']).strip()
                    if len(time_str) >= 14:
                        return datetime.strptime(time_str[:14], "%Y%m%d%H%M%S")
                    else:
                        return pd.NaT
                df['datetime'] = df.apply(parse_time, axis=1)
                df = df.dropna(subset=['datetime'])
                df = df[(df['datetime'].dt.hour >= 9) & (df['datetime'].dt.hour <= 15)]
                df.rename(columns={'open':'开盘','high':'最高','low':'最低','close':'收盘','volume':'成交量'}, inplace=True)
                for col in ['开盘','最高','最低','收盘','成交量']:
                    df[col] = df[col].astype(float)
                df['ts_code'] = str(code).zfill(6)
                df['trade_date'] = date_str
                return df[['datetime', '开盘', '收盘', '最高', '最低', '成交量', 'ts_code', 'trade_date']]
        else:
            print(f"查询失败 {code} {date_str}: {rs.error_msg}")
        if attempt < retries - 1:
            print(f"重试 {attempt+1}/{retries-1}...")
            time.sleep(delay)
    return pd.DataFrame()

# ============================
# 确定所有需要获取的 (code, date) 对（调仓日次日及之后4个交易日，共5天）
# ============================
bs.login()
print("Baostock 登录成功")

all_required_pairs = set()
HOLD_DAYS = 5

for plan in plans:
    rebalance_date = pd.to_datetime(plan['调仓日期'])
    stocks = plan['股票明细']
    for stock in stocks:
        code = stock['代码']
        daily_stock = df_daily[df_daily['code'] == code].sort_values('date')
        # 调仓日后的5个交易日（买入日 + 持有4天）
        future_daily = daily_stock[daily_stock['date'] > rebalance_date].head(HOLD_DAYS)
        if future_daily.empty:
            continue
        for date in future_daily['date']:
            date_str = date.strftime('%Y-%m-%d')
            all_required_pairs.add((code, date_str))

print(f"需要获取的 (股票, 交易日) 对数量: {len(all_required_pairs)}")

df_list = []
failed_pairs = []
total = len(all_required_pairs)
for idx, (code, date_str) in enumerate(all_required_pairs, 1):
    print(f"获取 {code} {date_str} ({idx}/{total})")
    df_tmp = fetch_5min_by_date(code, date_str)
    if not df_tmp.empty:
        df_list.append(df_tmp)
    else:
        failed_pairs.append((code, date_str))
    time.sleep(1.0)

bs.logout()
print(f"数据获取完成，成功 {len(df_list)} 个，失败 {len(failed_pairs)} 个")

if not df_list:
    print("未能获取到任何数据，请检查网络或稍后再试。")
else:
    df_min_all = pd.concat(df_list, ignore_index=True)
    print(f"5分钟数据总记录数: {len(df_min_all)}")

    # ============================
    # 回测函数：5日周期，买入第1天，卖出第5天
    # ============================
    def simulate_stock_trade_5min(code, rebalance_date, hold_days=5):
        daily_stock = df_daily[df_daily['code'] == code].sort_values('date')
        if daily_stock.empty:
            return None

        future_daily = daily_stock[daily_stock['date'] > rebalance_date].head(hold_days)
        if len(future_daily) == 0:
            return None

        future_dates = future_daily['date'].dt.strftime('%Y-%m-%d').tolist()
        actual_hold = min(hold_days, len(future_dates))
        future_dates = future_dates[:actual_hold]

        # 获取这些交易日的5分钟数据
        min_data = df_min_all[(df_min_all['ts_code'] == code) & (df_min_all['trade_date'].isin(future_dates))].copy()
        if min_data.empty:
            return None
        min_data = min_data.sort_values('datetime')

        # 买入：调仓日次日（第一个交易日）的第一根5分钟K线开盘价
        first_day_min = min_data[min_data['trade_date'] == future_dates[0]]
        if first_day_min.empty:
            return None
        buy_time = first_day_min.iloc[0]['datetime']
        buy_price = first_day_min.iloc[0]['开盘']

        # 卖出：最后一个交易日的最后一根5分钟K线收盘价
        last_day_min = min_data[min_data['trade_date'] == future_dates[-1]]
        if last_day_min.empty:
            return None
        sell_time = last_day_min.iloc[-1]['datetime']
        sell_price = last_day_min.iloc[-1]['收盘']

        ret = (sell_price / buy_price - 1) * 100
        return {
            '买入时间': str(buy_time),
            '买入价格': round(buy_price, 2),
            '卖出时间': str(sell_time),
            '卖出价格': round(sell_price, 2),
            '实际持有交易日': actual_hold,
            '收益(%)': round(ret, 2)
        }

    # ============================
    # 执行回测
    # ============================
    period_results = []
    all_trades = []
    for plan in plans:
        rebalance_date = pd.to_datetime(plan['调仓日期'])
        stocks = plan['股票明细']
        period_trades = []
        for stock in stocks:
            code = stock['代码']
            result = simulate_stock_trade_5min(code, rebalance_date)
            if result is not None:
                period_trades.append({'代码': code, '名称': stock.get('名称',''), **result})
        if not period_trades:
            continue
        period_ret = np.mean([t['收益(%)'] for t in period_trades])
        period_results.append({
            '调仓日期': plan['调仓日期'],
            '股票数量': len(period_trades),
            '组合收益(%)': period_ret,
            '股票明细': period_trades
        })
        all_trades.extend(period_trades)

    if not period_results:
        print("没有成功回测的交易。")
    else:
        period_df = pd.DataFrame(period_results)
        period_df['净值'] = (1 + period_df['组合收益(%)'] / 100).cumprod()
        total_return = (period_df['净值'].iloc[-1] - 1) * 100
        annual_return = (period_df['净值'].iloc[-1] ** (252 / (len(period_df) * HOLD_DAYS)) - 1) * 100
        max_drawdown = ((period_df['净值'] / period_df['净值'].cummax()) - 1).min() * 100
        sharpe = (period_df['组合收益(%)'].mean() / period_df['组合收益(%)'].std()) * np.sqrt(252/HOLD_DAYS) if period_df['组合收益(%)'].std() > 0 else np.nan
        win_rate = (period_df['组合收益(%)'] > 0).mean() * 100

        print("\n===== 5日周期回测绩效（5分钟数据） =====")
        print(f"总收益率: {total_return:.2f}%")
        print(f"年化收益率: {annual_return:.2f}%")
        print(f"最大回撤: {max_drawdown:.2f}%")
        print(f"夏普比率(每5日): {sharpe:.2f}")
        print(f"胜率: {win_rate:.2f}%")

        # 保存结果
        result_output = {
            "回测说明": "5日周期，调仓日次日开盘买入，第5个交易日收盘卖出",
            "调仓周期数": len(period_df),
            "绩效指标": {
                "总收益率(%)": round(total_return, 2),
                "年化收益率(%)": round(annual_return, 2),
                "最大回撤(%)": round(max_drawdown, 2),
                "夏普比率": round(sharpe, 2) if pd.notna(sharpe) else None,
                "胜率(%)": round(win_rate, 2)
            },
            "调仓周期明细": period_df[['调仓日期', '股票数量', '组合收益(%)', '净值']].to_dict('records'),
            "所有交易明细": all_trades
        }
        with open('5日周期交易模型_5分钟回测结果.json', 'w', encoding='utf-8') as f:
            json.dump(result_output, f, ensure_ascii=False, indent=2, default=str)
        print("\n回测结果已保存至 5日周期交易模型_回测结果.json")

        import matplotlib.pyplot as plt
        plt.figure(figsize=(10,5))
        plt.plot(period_df['调仓日期'], period_df['净值'], marker='o')
        plt.title('Portfolio Net Value (5-day Cycle)')
        plt.xlabel('Rebalance Date')
        plt.ylabel('Net Value')
        plt.grid(True)
        plt.show()
