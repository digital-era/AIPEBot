#@title 批量生成年度历史交易计划和回测结果文件提交到Github AIPEBot
import os
import json
import re
import glob
import shutil
import subprocess
import sys
import pandas as pd
import numpy as np
from datetime import datetime
from collections import defaultdict

# ============================
# 自动安装依赖（如果缺失）
# ============================
def install_package(package):
    try:
        __import__(package)
    except ImportError:
        print(f"正在安装 {package} ...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", package, "-q"])

install_package("xlsxwriter")
import xlsxwriter  # 确保导入

# ============================
# 配置信息
# ============================
SOURCE_DIR = "/content/AIPEQModel/Tradetest"          # 原始文件所在目录
OUTPUT_JSON_DIR = "/content/merged_yearly"            # 合并后的年度 JSON 输出目录
OUTPUT_EXCEL_DIR = "/content/yearly_excels"           # 生成的 Excel 输出目录

# GitHub 仓库 AIPEBot 信息
GIT_USERNAME = "digital-era"
GIT_EMAIL = "digital_era@sina.com"
GIT_REPO_NAME = "AIPEBot"
GIT_PAT = ""  # ⚠️ 请替换为有效的 GitHub Personal Access Token
GIT_TARGET_BRANCH = "main"
GIT_TARGET_DIR = "backtest"

# 创建输出目录
os.makedirs(OUTPUT_JSON_DIR, exist_ok=True)
os.makedirs(OUTPUT_EXCEL_DIR, exist_ok=True)

# ============================
# 1. 文件扫描与分类
# ============================
plan_pattern = re.compile(r'^5日周期交易计划_(\d{6})_(\d{6})\.json$')
backtest_pattern = re.compile(r'^5日周期交易计划_(\d{6})_(\d{6})_回测结果\.json$')

plan_files_by_year = defaultdict(list)
backtest_files_by_year = defaultdict(list)

for fname in os.listdir(SOURCE_DIR):
    full_path = os.path.join(SOURCE_DIR, fname)
    if not os.path.isfile(full_path):
        continue

    m = plan_pattern.match(fname)
    if m:
        start_ym = m.group(1)
        end_ym = m.group(2)
        year = start_ym[:4]
        plan_files_by_year[year].append((fname, start_ym, end_ym))
        continue

    m = backtest_pattern.match(fname)
    if m:
        start_ym = m.group(1)
        end_ym = m.group(2)
        year = start_ym[:4]
        backtest_files_by_year[year].append((fname, start_ym, end_ym))
        continue

print("交易计划文件按年份分组：", {y: len(v) for y, v in plan_files_by_year.items()})
print("回测结果文件按年份分组：", {y: len(v) for y, v in backtest_files_by_year.items()})

# ============================
# 2. 合并交易计划（按年）
# ============================
def merge_plan_files(year, file_list):
    all_plans = []
    common_rules = None

    for fname, start_ym, end_ym in file_list:
        filepath = os.path.join(SOURCE_DIR, fname)
        with open(filepath, 'r', encoding='utf-8') as f:
            data = json.load(f)

        if common_rules is None:
            common_rules = {
                "规则说明": data.get("规则说明", ""),
                "买入规则": data.get("买入规则", ""),
                "卖出规则": data.get("卖出规则", ""),
            }
        all_plans.extend(data.get("交易计划", []))

    if not all_plans:
        return None

    all_plans.sort(key=lambda x: x.get("调仓日期", ""))

    merged = {
        "规则说明": common_rules["规则说明"],
        "买入规则": common_rules["买入规则"],
        "卖出规则": common_rules["卖出规则"],
        "生成时间": datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "调仓周期数": len(all_plans),
        "交易计划": all_plans
    }
    return merged

for year, files in plan_files_by_year.items():
    merged_plan = merge_plan_files(year, files)
    if merged_plan:
        output_file = os.path.join(OUTPUT_JSON_DIR, f"5日周期交易计划_{year}.json")
        with open(output_file, 'w', encoding='utf-8') as f:
            json.dump(merged_plan, f, ensure_ascii=False, indent=2)
        print(f"已生成年度交易计划：{output_file}")

# ============================
# 3. 合并回测结果（按年，重新计算净值与绩效指标）
# ============================
def merge_backtest_files(year, file_list):
    all_periods = []
    all_trades = []
    common_desc = None

    for fname, start_ym, end_ym in file_list:
        filepath = os.path.join(SOURCE_DIR, fname)
        with open(filepath, 'r', encoding='utf-8') as f:
            data = json.load(f)

        if common_desc is None:
            common_desc = data.get("回测说明", "")
        periods = data.get("调仓周期明细", [])
        # 去除原始净值字段，后续重新计算
        for p in periods:
            p.pop('净值', None)
        all_periods.extend(periods)
        all_trades.extend(data.get("所有交易明细", []))

    if not all_periods:
        return None

    # 按调仓日期排序
    all_periods.sort(key=lambda x: x.get("调仓日期", ""))

    # 重新计算净值
    df_periods = pd.DataFrame(all_periods)
    if '调整后组合收益(%)' in df_periods.columns:
        ret_col = '调整后组合收益(%)'
    else:
        ret_col = '原始组合收益(%)'

    df_periods['净值'] = (1 + df_periods[ret_col] / 100).cumprod()

    total_return = (df_periods['净值'].iloc[-1] - 1) * 100
    n_periods = len(df_periods)
    annual_return = (df_periods['净值'].iloc[-1] ** (252 / (n_periods * 5)) - 1) * 100 if n_periods > 0 else 0
    max_drawdown = ((df_periods['净值'] / df_periods['净值'].cummax()) - 1).min() * 100

    std = df_periods[ret_col].std()
    sharpe = (df_periods[ret_col].mean() / std) * np.sqrt(252 / 5) if std > 0 else np.nan

    win_rate = (df_periods[ret_col] > 0).mean() * 100

    # 将重新计算的净值写回 all_periods
    for i, p in enumerate(all_periods):
        p['净值'] = round(float(df_periods['净值'].iloc[i]), 4)

    # 交易明细按买入时间排序（转换为 datetime 排序，再转换回字符串）
    if all_trades:
        trades_df_tmp = pd.DataFrame(all_trades)
        if '买入时间' in trades_df_tmp.columns:
            trades_df_tmp['_buy_time_parsed'] = pd.to_datetime(trades_df_tmp['买入时间'], errors='coerce')
            trades_df_tmp = trades_df_tmp.sort_values('_buy_time_parsed').drop(columns=['_buy_time_parsed'])
            all_trades = trades_df_tmp.to_dict('records')
        # 代码格式统一为6位字符串
        for trade in all_trades:
            if '代码' in trade:
                trade['代码'] = str(trade['代码']).zfill(6)

    merged = {
        "回测说明": common_desc,
        "调仓周期数": len(all_periods),
        "绩效指标": {
            "总收益率(%)": round(total_return, 2),
            "年化收益率(%)": round(annual_return, 2),
            "最大回撤(%)": round(max_drawdown, 2),
            "夏普比率": round(sharpe, 2) if pd.notna(sharpe) else None,
            "胜率(%)": round(win_rate, 2)
        },
        "调仓周期明细": all_periods,
        "所有交易明细": all_trades
    }
    return merged

for year, files in backtest_files_by_year.items():
    merged_bt = merge_backtest_files(year, files)
    if merged_bt:
        output_file = os.path.join(OUTPUT_JSON_DIR, f"5日周期交易计划_{year}_回测结果.json")
        with open(output_file, 'w', encoding='utf-8') as f:
            json.dump(merged_bt, f, ensure_ascii=False, indent=2)
        print(f"已生成年度回测结果：{output_file}")

# ============================
# 4. 年度回测结果 JSON 转 Excel
# ============================
def json_to_excel(year):
    json_file = os.path.join(OUTPUT_JSON_DIR, f"5日周期交易计划_{year}_回测结果.json")
    if not os.path.exists(json_file):
        print(f"警告：未找到 {json_file}，跳过该年份 Excel 生成")
        return

    with open(json_file, 'r', encoding='utf-8') as f:
        data = json.load(f)

    # 绩效指标 sheet
    perf = data.get("绩效指标", {})
    perf_df = pd.DataFrame(list(perf.items()), columns=["指标", "数值"])

    # 调仓明细 sheet - 按调仓日期升序（已在合并时排序，但以防万一再次排序）
    periods = data.get("调仓周期明细", [])
    periods_df = pd.DataFrame(periods)
    if not periods_df.empty and '调仓日期' in periods_df.columns:
        periods_df['调仓日期'] = pd.to_datetime(periods_df['调仓日期'])
        periods_df = periods_df.sort_values('调仓日期').reset_index(drop=True)
        periods_df['调仓日期'] = periods_df['调仓日期'].dt.strftime('%Y-%m-%d')  # 恢复为字符串

    # 交易明细 sheet - 按买入时间升序
    trades = data.get("所有交易明细", [])
    trades_df = pd.DataFrame(trades)
    if not trades_df.empty and '买入时间' in trades_df.columns:
        trades_df['_买入时间_parsed'] = pd.to_datetime(trades_df['买入时间'], errors='coerce')
        trades_df = trades_df.sort_values('_买入时间_parsed').drop(columns=['_买入时间_parsed']).reset_index(drop=True)
        # 确保代码为6位字符串
        if '代码' in trades_df.columns:
            trades_df['代码'] = trades_df['代码'].astype(str).str.zfill(6)

    excel_file = os.path.join(OUTPUT_EXCEL_DIR, f"5日周期交易计划_{year}_回测结果.xlsx")
    with pd.ExcelWriter(excel_file, engine='xlsxwriter') as writer:
        perf_df.to_excel(writer, sheet_name='绩效指标', index=False)
        periods_df.to_excel(writer, sheet_name='调仓明细', index=False)
        trades_df.to_excel(writer, sheet_name='交易明细', index=False)

    print(f"已生成 Excel：{excel_file}")

for year in backtest_files_by_year.keys():
    json_to_excel(year)

# ============================
# 5. 推送 Excel 和年度 JSON 到 AIPEBot 仓库的 backtest 目录
# ============================
def push_to_github():
    repo_dir = f"/content/{GIT_REPO_NAME}"
    if not os.path.exists(repo_dir):
        clone_url = f"https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git"
        print(f"克隆仓库 {GIT_REPO_NAME} ...")
        result = subprocess.run(['git', 'clone', clone_url, repo_dir],
                                capture_output=True, text=True)
        if result.returncode != 0:
            print("克隆失败：", result.stderr)
            return
    else:
        print("仓库已存在，拉取最新代码...")
        os.chdir(repo_dir)
        subprocess.run(['git', 'pull'], capture_output=True, text=True)

    os.chdir(repo_dir)

    target_dir = os.path.join(repo_dir, GIT_TARGET_DIR)
    os.makedirs(target_dir, exist_ok=True)

    # 复制 Excel 文件
    for fname in os.listdir(OUTPUT_EXCEL_DIR):
        if fname.endswith('.xlsx'):
            src = os.path.join(OUTPUT_EXCEL_DIR, fname)
            dst = os.path.join(target_dir, fname)
            shutil.copy2(src, dst)
            print(f"复制 Excel {fname} 到 {target_dir}")

    # 复制年度 JSON 文件（交易计划和回测结果）
    for fname in os.listdir(OUTPUT_JSON_DIR):
        if fname.endswith('.json'):
            src = os.path.join(OUTPUT_JSON_DIR, fname)
            dst = os.path.join(target_dir, fname)
            shutil.copy2(src, dst)
            print(f"复制 JSON {fname} 到 {target_dir}")

    subprocess.run(['git', 'config', 'user.name', GIT_USERNAME], check=True)
    subprocess.run(['git', 'config', 'user.email', GIT_EMAIL], check=True)

    subprocess.run(['git', 'add', GIT_TARGET_DIR], check=True)

    commit_msg = f"Add yearly backtest Excel and JSON files to {GIT_TARGET_DIR} at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
    subprocess.run(['git', 'commit', '-m', commit_msg], check=True)

    push_url = f"https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git"
    result = subprocess.run(['git', 'push', push_url, GIT_TARGET_BRANCH],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print("推送失败：", result.stderr)
    else:
        print("推送成功！")

push_to_github()

print("\n全部任务完成。")

