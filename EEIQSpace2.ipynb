    try:
        __import__(package)
    except ImportError:
        print(f"正在安装 {package} ...")
        subprocess.check_call([sys.executable, "-m", "pip", "install", package, "-q"])

install_package("xlsxwriter")
import xlsxwriter  # 确保导入

# ============================
# 配置
# ============================
TRADETEST_DIR = "/content/AIPEQModel/Tradetest"
GITHUB_USERNAME = "digital-era"
GITHUB_EMAIL = "digital_era@sina.com"
GITHUB_REPO_NAME = "AIPEBot"
GITHUB_PAT = ""  # ⚠️ 替换为有效 token
GITHUB_BRANCH = "main"
GITHUB_TARGET_DIR = "backtest"
LOCAL_REPO_DIR = f"/content/{GITHUB_REPO_NAME}"

# 增量文件名（可能为“测试结果”或“回测结果”）
INCREMENTAL_PLAN_FILE = "5日周期交易计划_New.json"
INCREMENTAL_BACKTEST_FILE_CANDIDATES = [
    "5日周期交易计划_New_测试结果.json",
    "5日周期交易计划_New_回测结果.json"
]

# ============================
# 辅助函数：克隆或更新仓库
# ============================
def ensure_repo():
    if not os.path.exists(LOCAL_REPO_DIR):
        print(f"克隆仓库 {GITHUB_REPO_NAME} ...")
        clone_url = f"https://{GITHUB_PAT}@github.com/{GITHUB_USERNAME}/{GITHUB_REPO_NAME}.git"
        result = subprocess.run(['git', 'clone', clone_url, LOCAL_REPO_DIR],
                                capture_output=True, text=True)
        if result.returncode != 0:
            print("克隆失败：", result.stderr)
            sys.exit(1)
    else:
        print("仓库已存在，拉取最新代码...")
        os.chdir(LOCAL_REPO_DIR)
        subprocess.run(['git', 'pull'], capture_output=True, text=True)

# ============================
# 读取增量文件
# ============================
def load_incremental_files():
    plan_path = os.path.join(TRADETEST_DIR, INCREMENTAL_PLAN_FILE)
    if not os.path.exists(plan_path):
        print(f"未找到增量交易计划文件：{plan_path}")
        return None, None

    backtest_path = None
    for cand in INCREMENTAL_BACKTEST_FILE_CANDIDATES:
        tmp = os.path.join(TRADETEST_DIR, cand)
        if os.path.exists(tmp):
            backtest_path = tmp
            break
    if backtest_path is None:
        print("未找到增量测试结果文件（New_测试结果/回测结果）")
        return None, None

    try:
        with open(plan_path, 'r', encoding='utf-8') as f:
            inc_plan = json.load(f)
        with open(backtest_path, 'r', encoding='utf-8') as f:
            inc_backtest = json.load(f)
    except Exception as e:
        print(f"读取增量文件失败: {e}")
        return None, None

    # 检查是否为空
    if not inc_plan.get('交易计划'):
        print("增量交易计划为空，跳过合并")
        return None, None
    if not inc_backtest.get('调仓周期明细') and not inc_backtest.get('所有交易明细'):
        print("增量测试结果为空，跳过合并")
        return None, None

    return inc_plan, inc_backtest

# ============================
# 获取年度文件路径
# ============================
def get_yearly_files(backtest_dir):
    """
    返回最大年份的年度交易计划和年度测试/回测结果文件路径。
    文件命名规则：
      交易计划：5日周期交易计划_YYYY.json
      测试结果：5日周期交易计划_YYYY_测试结果.json 或 5日周期交易计划_YYYY_回测结果.json
    """
    plan_pattern = re.compile(r'^5日周期交易计划_(\d{4})\.json$')
    backtest_pattern_test = re.compile(r'^5日周期交易计划_(\d{4})_(测试结果|回测结果)\.json$')

    max_year = -1
    max_plan_file = None
    max_backtest_file = None

    for fname in os.listdir(backtest_dir):
        m = plan_pattern.match(fname)
        if m:
            year = int(m.group(1))
            if year > max_year:
                max_year = year
                max_plan_file = fname
                # 同时寻找对应的回测结果文件
                for bname in os.listdir(backtest_dir):
                    bm = backtest_pattern_test.match(bname)
                    if bm and int(bm.group(1)) == year:
                        max_backtest_file = bname
                        break
            elif year == max_year:
                # 如果已经是最大年份，检查是否有多个回测文件（不太可能）
                pass

    if max_plan_file is None:
        return None, None, None

    return max_year, os.path.join(backtest_dir, max_plan_file), (os.path.join(backtest_dir, max_backtest_file) if max_backtest_file else None)

# ============================
# 合并交易计划
# ============================
def merge_plan_files(existing_plan, inc_plan):
    """
    将增量交易计划合并到现有年度计划中，按调仓日期排序去重。
    """
    if existing_plan is None:
        # 没有现有计划，直接使用增量计划内容
        merged_plan = inc_plan.copy()
    else:
        merged_plan = existing_plan.copy()
        existing_plans = merged_plan.get('交易计划', [])
        inc_plans = inc_plan.get('交易计划', [])
        # 合并
        combined = existing_plans + inc_plans
        # 去重（按调仓日期和股票明细？简化：只按调仓日期去重，保留后者）
        seen_dates = set()
        unique_plans = []
        for p in combined:
            d = p.get('调仓日期')
            if d not in seen_dates:
                seen_dates.add(d)
                unique_plans.append(p)
        unique_plans.sort(key=lambda x: x.get('调仓日期', ''))
        merged_plan['交易计划'] = unique_plans
        merged_plan['调仓周期数'] = len(unique_plans)
        merged_plan['生成时间'] = datetime.now().strftime('%Y-%m-%d %H:%M:%S')
        # 更新规则说明等，可保留原有规则
    return merged_plan

# ============================
# 合并回测结果并重新计算绩效
# ============================
def merge_backtest_and_recalculate(existing_backtest, inc_backtest):
    """
    合并调仓周期明细和交易明细，重新计算净值与绩效指标。
    """
    if existing_backtest is None:
        # 直接使用增量数据，但也要重新计算净值（可能净值字段已有）
        all_periods = inc_backtest.get('调仓周期明细', [])
        all_trades = inc_backtest.get('所有交易明细', [])
        common_desc = inc_backtest.get('回测说明', '')
    else:
        all_periods = existing_backtest.get('调仓周期明细', []) + inc_backtest.get('调仓周期明细', [])
        all_trades = existing_backtest.get('所有交易明细', []) + inc_backtest.get('所有交易明细', [])
        common_desc = existing_backtest.get('回测说明', inc_backtest.get('回测说明', ''))

    if not all_periods:
        return None

    # 去除旧净值，排序
    for p in all_periods:
        p.pop('净值', None)
    all_periods.sort(key=lambda x: x.get('调仓日期', ''))

    # 重新计算净值
    df_periods = pd.DataFrame(all_periods)
    ret_col = '调整后组合收益(%)' if '调整后组合收益(%)' in df_periods.columns else '原始组合收益(%)'
    df_periods['净值'] = (1 + df_periods[ret_col] / 100).cumprod()

    # 绩效指标
    total_return = (df_periods['净值'].iloc[-1] - 1) * 100
    n_periods = len(df_periods)
    annual_return = (df_periods['净值'].iloc[-1] ** (252 / (n_periods * 5)) - 1) * 100 if n_periods > 0 else 0
    max_drawdown = ((df_periods['净值'] / df_periods['净值'].cummax()) - 1).min() * 100
    std = df_periods[ret_col].std()
    sharpe = (df_periods[ret_col].mean() / std) * np.sqrt(252 / 5) if std > 0 else np.nan
    win_rate = (df_periods[ret_col] > 0).mean() * 100

    # 将净值写回 periods
    for i, p in enumerate(all_periods):
        p['净值'] = round(float(df_periods['净值'].iloc[i]), 4)

    # 交易明细按买入时间排序，代码格式统一
    if all_trades:
        trades_df = pd.DataFrame(all_trades)
        if '买入时间' in trades_df.columns:
            trades_df['_买入时间_parsed'] = pd.to_datetime(trades_df['买入时间'], errors='coerce')
            trades_df = trades_df.sort_values('_买入时间_parsed').drop(columns=['_买入时间_parsed'])
        if '代码' in trades_df.columns:
            trades_df['代码'] = trades_df['代码'].astype(str).str.zfill(6)
        all_trades = trades_df.to_dict('records')

    merged_backtest = {
        "回测说明": common_desc,
        "调仓周期数": len(all_periods),
        "绩效指标": {
            "总收益率(%)": round(total_return, 2),
            "年化收益率(%)": round(annual_return, 2),
            "最大回撤(%)": round(max_drawdown, 2),
            "夏普比率": round(sharpe, 2) if pd.notna(sharpe) else None,
            "胜率(%)": round(win_rate, 2)
        },
        "调仓周期明细": all_periods,
        "所有交易明细": all_trades
    }
    return merged_backtest

# ============================
# 生成 Excel
# ============================
def generate_excel(year, backtest_data, output_dir):
    perf = backtest_data.get("绩效指标", {})
    perf_df = pd.DataFrame(list(perf.items()), columns=["指标", "数值"])

    periods = backtest_data.get("调仓周期明细", [])
    periods_df = pd.DataFrame(periods)
    if not periods_df.empty and '调仓日期' in periods_df.columns:
        periods_df['调仓日期'] = pd.to_datetime(periods_df['调仓日期'])
        periods_df = periods_df.sort_values('调仓日期')
        periods_df['调仓日期'] = periods_df['调仓日期'].dt.strftime('%Y-%m-%d')

    trades = backtest_data.get("所有交易明细", [])
    trades_df = pd.DataFrame(trades)
    if not trades_df.empty and '买入时间' in trades_df.columns:
        trades_df['_买入时间_parsed'] = pd.to_datetime(trades_df['买入时间'], errors='coerce')
        trades_df = trades_df.sort_values('_买入时间_parsed').drop(columns=['_买入时间_parsed'])
        if '代码' in trades_df.columns:
            trades_df['代码'] = trades_df['代码'].astype(str).str.zfill(6)

    excel_file = os.path.join(output_dir, f"5日周期交易计划_{year}_回测结果.xlsx")
    with pd.ExcelWriter(excel_file, engine='xlsxwriter') as writer:
        perf_df.to_excel(writer, sheet_name='绩效指标', index=False)
        periods_df.to_excel(writer, sheet_name='调仓明细', index=False)
        trades_df.to_excel(writer, sheet_name='交易明细', index=False)
    print(f"已生成 Excel：{excel_file}")
    return excel_file

# ============================
# 主流程
# ============================
def main():
    # 1. 克隆/更新仓库
    ensure_repo()

    backtest_dir = os.path.join(LOCAL_REPO_DIR, GITHUB_TARGET_DIR)
    os.makedirs(backtest_dir, exist_ok=True)

    # 2. 读取增量文件
    inc_plan, inc_backtest = load_incremental_files()
    if inc_plan is None or inc_backtest is None:
        print("没有有效的增量文件，结束任务。")
        return

    # 3. 获取最大年份的年度文件
    year, plan_file_path, backtest_file_path = get_yearly_files(backtest_dir)
    if year is None:
        # 如果没有任何年度文件，则根据增量中第一个调仓日期的年份创建新年度文件
        first_date = inc_plan['交易计划'][0]['调仓日期']
        year = int(first_date[:4])
        existing_plan = None
        existing_backtest = None
        print(f"未找到年度文件，将创建年份为 {year} 的新文件。")
    else:
        print(f"找到最大年份为 {year} 的年度文件。")
        # 读取现有年度文件
        existing_plan = None
        existing_backtest = None
        if os.path.exists(plan_file_path):
            with open(plan_file_path, 'r', encoding='utf-8') as f:
                existing_plan = json.load(f)
        if backtest_file_path and os.path.exists(backtest_file_path):
            with open(backtest_file_path, 'r', encoding='utf-8') as f:
                existing_backtest = json.load(f)

    # 4. 合并交易计划
    merged_plan = merge_plan_files(existing_plan, inc_plan)

    # 5. 合并回测结果并重算
    merged_backtest = merge_backtest_and_recalculate(existing_backtest, inc_backtest)

    if merged_plan is None or merged_backtest is None:
        print("合并失败，请检查数据。")
        return

    # 6. 写回年度 JSON 文件
    plan_out = os.path.join(backtest_dir, f"5日周期交易计划_{year}.json")
    backtest_out = os.path.join(backtest_dir, f"5日周期交易计划_{year}_回测结果.json")
    # 同时兼容“测试结果”命名？我们统一使用“回测结果”，但之前可能使用测试结果，这里根据实际情况选择
    # 如果已有“测试结果”文件存在，则保留测试结果命名；否则用回测结果
    if backtest_file_path and "测试结果" in backtest_file_path:
        backtest_out = backtest_file_path
    with open(plan_out, 'w', encoding='utf-8') as f:
        json.dump(merged_plan, f, ensure_ascii=False, indent=2)
    with open(backtest_out, 'w', encoding='utf-8') as f:
        json.dump(merged_backtest, f, ensure_ascii=False, indent=2)
    print(f"年度交易计划已更新：{plan_out}")
    print(f"年度回测结果已更新：{backtest_out}")

    # 7. 生成 Excel
    excel_file = generate_excel(year, merged_backtest, backtest_dir)

    # 8. Git 提交推送
    os.chdir(LOCAL_REPO_DIR)
    subprocess.run(['git', 'config', 'user.name', GITHUB_USERNAME], check=True)
    subprocess.run(['git', 'config', 'user.email', GITHUB_EMAIL], check=True)
    subprocess.run(['git', 'add', GITHUB_TARGET_DIR], check=True)

    commit_msg = f"Update yearly files with incremental New data at {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
    subprocess.run(['git', 'commit', '-m', commit_msg], check=True)

    push_url = f"https://{GITHUB_PAT}@github.com/{GITHUB_USERNAME}/{GITHUB_REPO_NAME}.git"
    result = subprocess.run(['git', 'push', push_url, GITHUB_BRANCH],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print("推送失败：", result.stderr)
    else:
        print("推送成功！")

if __name__ == "__main__":
    main()


#@title Zip 5min_cache Directory
import zipfile
from pathlib import Path

# ==================== 配置区 ====================
source_dir = Path("/content/5min_cache")
zip_file_path = Path("/content/5min_cache.zip")   # 输出 zip 路径，可自行修改

# ==================== 执行打包 ====================
if source_dir.exists():
    with zipfile.ZipFile(zip_file_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
        file_count = 0

        for file in source_dir.rglob("*"):          # 递归获取所有文件
            if file.is_file():
                # 保留目录结构（推荐）
                arcname = file.relative_to(source_dir.parent)
                zipf.write(file, arcname)
                file_count += 1
                print(f"已添加: {file.name}")

    print(f"\n✅ 打包完成！")
    print(f"共打包 {file_count} 个文件")
    print(f"输出路径：{zip_file_path}")
    print(f"文件大小：{zip_file_path.stat().st_size / (1024*1024):.2f} MB")

else:
    print(f"❌ 源目录不存在：{source_dir}")


