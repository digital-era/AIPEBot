#@title 生成10日周期交易计划（含MA20风控 + 仓位因子）
import pandas as pd
import json
import os
import re
from datetime import datetime

# ============================
# 1. 提取每个日期的仓位因子
# ============================
base_dir = '/content/AIPEQModel'
pattern = re.compile(r'^流入模型_(\d{4}-\d{2}-\d{2})\.json$')
date_to_position_factor = {}

if os.path.isdir(base_dir):
    for fname in os.listdir(base_dir):
        m = pattern.match(fname)
        if not m:
            continue
        date_str = m.group(1)
        filepath = os.path.join(base_dir, fname)
        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                data = json.load(f)
            risk_info = data.get('结果', {}).get('风控因子信息', {})
            factor_str = risk_info.get('综合建议仓位因子', '1.0')
            factor = float(factor_str)
            date_to_position_factor[date_str] = factor
        except Exception as e:
            print(f"解析 {fname} 失败: {e}")
            date_to_position_factor[date_str] = 1.0
else:
    print("模型目录不存在，仓位因子全部默认为1.0")

# ============================
# 2. 准备信号数据
# ============================
if 'unique_date_code_pairs' not in globals():
    raise ValueError("未找到 unique_date_code_pairs")

pairs_df = pd.DataFrame(unique_date_code_pairs, columns=['signal_date', 'code'])
pairs_df['signal_date'] = pd.to_datetime(pairs_df['signal_date']).dt.normalize()
pairs_df['code'] = pairs_df['code'].astype(str).str.zfill(6)

date_to_codes = pairs_df.groupby('signal_date')['code'].apply(list).to_dict()
all_signal_dates = sorted(date_to_codes.keys())
print(f"信号日期数量: {len(all_signal_dates)}")

REBALANCE_PERIOD = 10
rebalance_dates = all_signal_dates[::REBALANCE_PERIOD]
print(f"调仓日数量: {len(rebalance_dates)}")

# 名称映射
name_map = {}
if 'df_combined' in globals() and '名称' in df_combined.columns:
    df_combined_copy = df_combined.copy()
    code_col = '代码' if '代码' in df_combined_copy.columns else 'code'
    df_combined_copy[code_col] = df_combined_copy[code_col].astype(str).str.zfill(6)
    name_map = df_combined_copy.drop_duplicates(code_col).set_index(code_col)['名称'].to_dict()

# ============================
# 3. 生成交易计划
# ============================
plans = []

for rebalance_date in rebalance_dates:
    codes = date_to_codes[rebalance_date]
    if not codes:
        continue

    top_codes = codes[:3]
    date_str = rebalance_date.strftime('%Y-%m-%d')
    position_factor = date_to_position_factor.get(date_str, 1.0)  # 默认满仓

    stocks_rules = []
    for code in top_codes:
        stocks_rules.append({
            "代码": code,
            "名称": name_map.get(code, ""),
            "买入规则": "第1天买入（调仓日次日开盘价）",
            "卖出规则": "持有期内若收盘价跌破20日均线（MA20）则立即卖出；否则持有至第10个交易日收盘卖出"
        })

    plans.append({
        "调仓日期": date_str,
        "仓位因子": position_factor,
        "股票数量": len(stocks_rules),
        "股票明细": stocks_rules
    })

# ============================
# 4. 输出JSON
# ============================
output = {
    "规则说明": f"每{REBALANCE_PERIOD}个交易日调仓一次，标的来源于基础模型（unique_date_code_pairs），取前3只。每期仓位根据基础模型风控因子动态调整。",
    "买入规则": "第1天买入（调仓日次日开盘价）",
    "卖出规则": "持有期内若收盘价跌破20日均线（MA20）则立即卖出；否则持有至第10个交易日收盘卖出",
    "生成时间": datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
    "调仓周期数": len(plans),
    "交易计划": plans
}


# 提取调仓日期列表
if plans:
    all_plan_dates = [pd.to_datetime(plan['调仓日期']) for plan in plans]
    min_date = min(all_plan_dates)
    max_date = max(all_plan_dates)
    date_str_range = f"{min_date.strftime('%Y%m')}_{max_date.strftime('%Y%m')}"
    output_filename = f"10日周期交易计划_{date_str_range}.json"
else:
    output_filename = "10日周期交易计划_empty.json"

with open(output_filename, 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f"交易计划已保存至 {output_filename}，共 {len(plans)} 个调仓周期")
print(json.dumps(output, ensure_ascii=False, indent=2)[:1500])


#@title 10日周期回测（BaoStock 5分钟数据 + MA20风控 + 动态仓位 + 缓存续传）
import pandas as pd
import numpy as np
import json
import os
import time
import subprocess
import sys
from datetime import datetime, timedelta

try:
    import baostock as bs
except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "baostock", "-q"])
    import baostock as bs

# ============================
# 参数设置
# ============================
PLAN_FILE = '10日周期交易计划_202501_202509.json'
CACHE_DIR = './5min_cache_10d'        # 缓存目录，与持有期区分
HOLD_DAYS = 10
RETRY_DELAY = 1.5
REQUEST_DELAY = 1.0

# ============================
# 读取交易计划
# ============================
with open(PLAN_FILE, 'r', encoding='utf-8') as f:
    trade_plan_json = json.load(f)
plans = trade_plan_json['交易计划']
print(f"调仓周期数: {len(plans)}")

# ============================
# 准备日线数据（含MA20）
# ============================
if 'df_combined' not in globals():
    raise ValueError("请先加载 df_combined")

date_col = next((c for c in ['日期','date','trade_date','datetime'] if c in df_combined.columns), None)
code_col = next((c for c in ['代码','code','ts_code'] if c in df_combined.columns), None)
close_col = next((c for c in ['收盘价','close'] if c in df_combined.columns), None)
if not date_col or not code_col or not close_col:
    raise KeyError("日线数据缺少必要列")

df_daily = df_combined[[date_col, code_col, close_col]].copy()
df_daily.columns = ['date', 'code', 'close']
df_daily['date'] = pd.to_datetime(df_daily['date'])
df_daily['code'] = df_daily['code'].astype(str).str.zfill(6)
df_daily = df_daily.sort_values(['code', 'date']).reset_index(drop=True)

# 计算MA20（使用调仓日前一日数据）
df_daily['MA20'] = df_daily.groupby('code')['close'].transform(lambda x: x.rolling(20).mean().shift(1))

# ============================
# BaoStock 5分钟数据获取函数（单日，含重试）
# ============================
def to_bs_code(code):
    code = str(code).zfill(6)
    return f"sh.{code}" if code.startswith('6') else f"sz.{code}"

def fetch_5min_by_date(code, date_str, retries=3):
    bs_code = to_bs_code(code)
    for attempt in range(retries):
        try:
            rs = bs.query_history_k_data_plus(
                bs_code,
                "date,time,open,high,low,close,volume",
                start_date=date_str,
                end_date=date_str,
                frequency="5",
                adjustflag="3"
            )
            if rs.error_code == '0':
                data = rs.get_data()
                if len(data) > 0:
                    df = pd.DataFrame(data, columns=rs.fields)
                    df = df[df['date'].notna() & df['time'].notna()]
                    def parse_time(row):
                        time_str = str(row['time']).strip()
                        if len(time_str) >= 14:
                            return datetime.strptime(time_str[:14], "%Y%m%d%H%M%S")
                        else:
                            return pd.NaT
                    df['datetime'] = df.apply(parse_time, axis=1)
                    df = df.dropna(subset=['datetime'])
                    df = df[(df['datetime'].dt.hour >= 9) & (df['datetime'].dt.hour <= 15)]
                    df.rename(columns={'open':'开盘','high':'最高','low':'最低','close':'收盘','volume':'成交量'}, inplace=True)
                    for col in ['开盘','最高','最低','收盘','成交量']:
                        df[col] = df[col].astype(float)
                    df['ts_code'] = str(code).zfill(6)
                    df['trade_date'] = date_str
                    return df[['datetime', '开盘', '收盘', '最高', '最低', '成交量', 'ts_code', 'trade_date']]
            else:
                print(f"查询失败 {code} {date_str}: {rs.error_msg}")
        except Exception as e:
            print(f"获取异常 {code} {date_str}: {e}")
        if attempt < retries - 1:
            print(f"重试 {attempt+1}/{retries-1}...")
            time.sleep(RETRY_DELAY)
    return pd.DataFrame()

# ============================
# 缓存功能
# ============================
def get_cache_path(code, date_str):
    return os.path.join(CACHE_DIR, f"{code}_{date_str}.parquet")

def is_cached(code, date_str):
    path = get_cache_path(code, date_str)
    return os.path.exists(path) and os.path.getsize(path) > 0

def load_from_cache(code, date_str):
    try:
        return pd.read_parquet(get_cache_path(code, date_str))
    except Exception as e:
        print(f"读取缓存失败 {code} {date_str}: {e}")
        return pd.DataFrame()

def save_to_cache(df, code, date_str):
    if df.empty:
        return
    os.makedirs(CACHE_DIR, exist_ok=True)
    try:
        df.to_parquet(get_cache_path(code, date_str), index=False, engine='pyarrow')
    except Exception as e:
        print(f"保存缓存失败 {code} {date_str}: {e}")

# ============================
# 收集所有需要的数据对
# ============================
all_required_pairs = set()
for plan in plans:
    rebalance_date = pd.to_datetime(plan['调仓日期'])
    stocks = plan['股票明细']
    for stock in stocks:
        code = stock['代码']
        daily_stock = df_daily[df_daily['code'] == code].sort_values('date')
        future_daily = daily_stock[daily_stock['date'] > rebalance_date].head(HOLD_DAYS)
        if len(future_daily) < HOLD_DAYS:
            continue
        for date in future_daily['date']:
            date_str = date.strftime('%Y-%m-%d')
            all_required_pairs.add((code, date_str))

print(f"总共需要 (股票, 日期) 对: {len(all_required_pairs)}")

# 检查缓存
cached_pairs = {(c, d) for c, d in all_required_pairs if is_cached(c, d)}
missing_pairs = all_required_pairs - cached_pairs
print(f"已缓存: {len(cached_pairs)} 对")
print(f"需要获取: {len(missing_pairs)} 对")

# ============================
# 读取已有缓存，获取缺失数据
# ============================
cached_df_list = []
for code, date_str in cached_pairs:
    df_tmp = load_from_cache(code, date_str)
    if not df_tmp.empty:
        cached_df_list.append(df_tmp)
    else:
        # 缓存可能损坏，重新加入缺失列表
        missing_pairs.add((code, date_str))

# 如果有缺失数据，才登录 Baostock
if missing_pairs:
    bs.login()
    print("Baostock 登录成功")
    total_missing = len(missing_pairs)
    try:
        for idx, (code, date_str) in enumerate(missing_pairs, 1):
            print(f"获取 {code} {date_str} ({idx}/{total_missing})")
            df_tmp = fetch_5min_by_date(code, date_str)
            if not df_tmp.empty:
                save_to_cache(df_tmp, code, date_str)
                cached_df_list.append(df_tmp)
            else:
                print(f"警告: 未能获取 {code} {date_str}")
            time.sleep(REQUEST_DELAY)
    finally:
        bs.logout()
        print("Baostock 登出")
else:
    print("没有缺失数据，跳过网络请求。")

if not cached_df_list:
    print("没有可用的5分钟数据，无法回测。")
    import sys
    sys.exit(0)

df_min_all = pd.concat(cached_df_list, ignore_index=True)
print(f"合并后的5分钟数据记录数: {len(df_min_all)}")

# ============================
# 回测函数（含MA20风控）
# ============================
def simulate_stock_trade_5min(code, rebalance_date):
    daily_stock = df_daily[df_daily['code'] == code].sort_values('date')
    if daily_stock.empty:
        return None

    prev_day = daily_stock[daily_stock['date'] <= rebalance_date].tail(1)
    if prev_day.empty:
        return None
    ma20_threshold = prev_day.iloc[0]['MA20']
    if pd.isna(ma20_threshold):
        ma20_threshold = None

    future_daily = daily_stock[daily_stock['date'] > rebalance_date].head(HOLD_DAYS)
    if len(future_daily) < HOLD_DAYS:
        return None
    future_dates = future_daily['date'].dt.strftime('%Y-%m-%d').tolist()

    min_data = df_min_all[(df_min_all['ts_code'] == code) & (df_min_all['trade_date'].isin(future_dates))].copy()
    if min_data.empty:
        return None
    min_data = min_data.sort_values('datetime')

    first_day_min = min_data[min_data['trade_date'] == future_dates[0]]
    if first_day_min.empty:
        return None
    buy_time = first_day_min.iloc[0]['datetime']
    buy_price = first_day_min.iloc[0]['开盘']

    sell_time = None
    sell_price = None

    if ma20_threshold is not None:
        after_buy = min_data[min_data['datetime'] > buy_time]
        for date_str in future_dates:
            day_min = after_buy[after_buy['trade_date'] == date_str]
            if day_min.empty:
                continue
            trigger = day_min[day_min['收盘'] < ma20_threshold]
            if not trigger.empty:
                sell_time = trigger.iloc[0]['datetime']
                sell_price = trigger.iloc[0]['收盘']
                break

    if sell_time is None:
        last_day_min = min_data[min_data['trade_date'] == future_dates[-1]]
        if last_day_min.empty:
            return None
        sell_time = last_day_min.iloc[-1]['datetime']
        sell_price = last_day_min.iloc[-1]['收盘']

    ret = (sell_price / buy_price - 1) * 100
    return {
        '买入时间': str(buy_time),
        '买入价格': round(buy_price, 2),
        '卖出时间': str(sell_time),
        '卖出价格': round(sell_price, 2),
        '收益(%)': round(ret, 2)
    }

# ============================
# 执行回测（应用仓位因子）
# ============================
period_results = []
all_trades = []

for plan in plans:
    rebalance_date = pd.to_datetime(plan['调仓日期'])
    position_factor = plan.get('仓位因子', 1.0)
    stocks = plan['股票明细']
    period_trades = []
    for stock in stocks:
        code = stock['代码']
        result = simulate_stock_trade_5min(code, rebalance_date)
        if result is not None:
            period_trades.append({'代码': code, '名称': stock.get('名称', ''), **result})
    if not period_trades:
        continue
    period_ret = np.mean([t['收益(%)'] for t in period_trades])
    period_ret_adjusted = period_ret * position_factor
    period_results.append({
        '调仓日期': plan['调仓日期'],
        '仓位因子': position_factor,
        '股票数量': len(period_trades),
        '原始组合收益(%)': period_ret,
        '调整后组合收益(%)': period_ret_adjusted,
        '股票明细': period_trades
    })
    all_trades.extend(period_trades)

# ============================
# 绩效汇总
# ============================
if not period_results:
    print("没有成功回测的交易。")
else:
    period_df = pd.DataFrame(period_results)
    period_df['净值'] = (1 + period_df['调整后组合收益(%)'] / 100).cumprod()

    total_return = (period_df['净值'].iloc[-1] - 1) * 100
    n_periods = len(period_df)
    annual_return = (period_df['净值'].iloc[-1] ** (252 / (n_periods * HOLD_DAYS)) - 1) * 100 if n_periods > 0 else 0
    max_drawdown = ((period_df['净值'] / period_df['净值'].cummax()) - 1).min() * 100
    sharpe = (period_df['调整后组合收益(%)'].mean() / period_df['调整后组合收益(%)'].std()) * np.sqrt(252 / HOLD_DAYS) if period_df['调整后组合收益(%)'].std() > 0 else np.nan
    win_rate = (period_df['调整后组合收益(%)'] > 0).mean() * 100

    print("\n===== 10日周期回测绩效（含仓位因子） =====")
    print(f"总收益率: {total_return:.2f}%")
    print(f"年化收益率: {annual_return:.2f}%")
    print(f"最大回撤: {max_drawdown:.2f}%")
    print(f"夏普比率(每{HOLD_DAYS}日): {sharpe:.2f}")
    print(f"胜率: {win_rate:.2f}%")

    result_output = {
        "回测说明": "10日周期，基于unique_date_code_pairs，买入次日开盘，持有期内5分钟收盘价跌破MA20则卖出，否则持有10日。每期仓位根据基础模型风控因子动态调整。",
        "调仓周期数": len(period_df),
        "绩效指标": {
            "总收益率(%)": round(total_return, 2),
            "年化收益率(%)": round(annual_return, 2),
            "最大回撤(%)": round(max_drawdown, 2),
            "夏普比率": round(sharpe, 2) if pd.notna(sharpe) else None,
            "胜率(%)": round(win_rate, 2)
        },
        "调仓周期明细": period_df[['调仓日期', '仓位因子', '股票数量', '原始组合收益(%)', '调整后组合收益(%)', '净值']].to_dict('records'),
        "所有交易明细": all_trades
    }

    # 动态生成文件名
    plan_dates = [pd.to_datetime(plan['调仓日期']) for plan in plans]
    min_date = min(plan_dates)
    max_date = max(plan_dates)
    date_range_str = f"{min_date.strftime('%Y%m')}_{max_date.strftime('%Y%m')}"
    output_filename = f"10日周期交易计划_{date_range_str}_回测结果.json"

    with open(output_filename, 'w', encoding='utf-8') as f:
        json.dump(result_output, f, ensure_ascii=False, indent=2, default=str)
    print(f"\n回测结果已保存至 {output_filename}")

    import matplotlib.pyplot as plt
    plt.figure(figsize=(10, 5))
    plt.plot(period_df['调仓日期'], period_df['净值'], marker='o')
    plt.title('Portfolio Net Value (10-day Cycle + MA20 Stop + Position Factor)')
    plt.xlabel('Rebalance Date')
    plt.ylabel('Net Value')
    plt.grid(True)
    plt.show()


#@title 生成5日周期交易计划（所有标的等权，含MA20风控 + 仓位因子）
import pandas as pd
import json
import os
import re
from datetime import datetime

# ============================
# 1. 提取每个日期的仓位因子
# ============================
base_dir = '/content/AIPEQModel'
pattern = re.compile(r'^流入模型_(\d{4}-\d{2}-\d{2})\.json$')
date_to_position_factor = {}

if os.path.isdir(base_dir):
    for fname in os.listdir(base_dir):
        m = pattern.match(fname)
        if not m:
            continue
        date_str = m.group(1)
        filepath = os.path.join(base_dir, fname)
        try:
            with open(filepath, 'r', encoding='utf-8') as f:
                data = json.load(f)
            risk_info = data.get('结果', {}).get('风控因子信息', {})
            factor_str = risk_info.get('综合建议仓位因子', '1.0')
            factor = float(factor_str)
            date_to_position_factor[date_str] = factor
        except Exception as e:
            print(f"解析 {fname} 失败: {e}")
            date_to_position_factor[date_str] = 1.0
else:
    print("模型目录不存在，仓位因子全部默认为1.0")

# ============================
# 2. 准备信号数据（所有标的）
# ============================
if 'unique_date_code_pairs' not in globals():
    raise ValueError("未找到 unique_date_code_pairs")

pairs_df = pd.DataFrame(unique_date_code_pairs, columns=['signal_date', 'code'])
pairs_df['signal_date'] = pd.to_datetime(pairs_df['signal_date']).dt.normalize()
pairs_df['code'] = pairs_df['code'].astype(str).str.zfill(6)

date_to_codes = pairs_df.groupby('signal_date')['code'].apply(list).to_dict()
all_signal_dates = sorted(date_to_codes.keys())
print(f"信号日期数量: {len(all_signal_dates)}")

REBALANCE_PERIOD = 5  # 修改为5日周期
rebalance_dates = all_signal_dates[::REBALANCE_PERIOD]
print(f"调仓日数量: {len(rebalance_dates)}")

# 名称映射
name_map = {}
if 'df_combined' in globals() and '名称' in df_combined.columns:
    df_combined_copy = df_combined.copy()
    code_col = '代码' if '代码' in df_combined_copy.columns else 'code'
    df_combined_copy[code_col] = df_combined_copy[code_col].astype(str).str.zfill(6)
    name_map = df_combined_copy.drop_duplicates(code_col).set_index(code_col)['名称'].to_dict()

# ============================
# 3. 生成交易计划（等权纳入所有标的）
# ============================
plans = []

for rebalance_date in rebalance_dates:
    codes = date_to_codes[rebalance_date]
    if not codes:
        continue

    n_stocks = len(codes)
    weight_percent = round(100.0 / n_stocks, 2) if n_stocks > 0 else 0.0

    date_str = rebalance_date.strftime('%Y-%m-%d')
    position_factor = date_to_position_factor.get(date_str, 1.0)

    stocks_rules = []
    for code in codes:
        stocks_rules.append({
            "代码": code,
            "名称": name_map.get(code, ""),
            "权重(%)": f"{weight_percent:.2f}%",
            "买入规则": "第1天买入（调仓日次日开盘价）",
            "卖出规则": "持有期内若收盘价跌破20日均线（MA20）则立即卖出；否则持有至第5个交易日收盘卖出"  # 改为5日
        })

    plans.append({
        "调仓日期": date_str,
        "仓位因子": position_factor,
        "股票数量": n_stocks,
        "股票明细": stocks_rules
    })

# ============================
# 4. 输出JSON
# ============================
output = {
    "规则说明": f"每{REBALANCE_PERIOD}个交易日调仓一次，标的来源于基础模型（unique_date_code_pairs），所有标的等权纳入。每期仓位根据基础模型风控因子动态调整。",
    "买入规则": "第1天买入（调仓日次日开盘价）",
    "卖出规则": "持有期内若收盘价跌破20日均线（MA20）则立即卖出；否则持有至第5个交易日收盘卖出",
    "生成时间": datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
    "调仓周期数": len(plans),
    "交易计划": plans
}

# 提取调仓日期列表
if plans:
    all_plan_dates = [pd.to_datetime(plan['调仓日期']) for plan in plans]
    min_date = min(all_plan_dates)
    max_date = max(all_plan_dates)
    date_str_range = f"{min_date.strftime('%Y%m')}_{max_date.strftime('%Y%m')}"
    output_filename = f"5日周期交易计划_{date_str_range}.json"
else:
    output_filename = "5日周期交易计划_empty.json"

with open(output_filename, 'w', encoding='utf-8') as f:
    json.dump(output, f, ensure_ascii=False, indent=2)

print(f"交易计划已保存至 {output_filename}，共 {len(plans)} 个调仓周期")
print(json.dumps(output, ensure_ascii=False, indent=2)[:1500])


#@title 5日周期回测（断点续传，缓存5分钟数据）
import pandas as pd
import numpy as np
import json
import os
import time
import subprocess
import sys
from datetime import datetime, timedelta

try:
    import baostock as bs
except ImportError:
    subprocess.check_call([sys.executable, "-m", "pip", "install", "baostock", "-q"])
    import baostock as bs

# ============================
# 参数设置
# ============================
PLAN_FILE = '5日周期交易计划_202501_202509.json'
CACHE_DIR = './5min_cache'          # 缓存目录
HOLD_DAYS = 5                       # 持有期天数
RETRY_DELAY = 1.0                   # 获取失败后的重试间隔
REQUEST_DELAY = 0.8                 # 每次请求之间的延迟，避免触发限制

# ============================
# 读取交易计划
# ============================
with open(PLAN_FILE, 'r', encoding='utf-8') as f:
    trade_plan_json = json.load(f)
plans = trade_plan_json['交易计划']
print(f"调仓周期数: {len(plans)}")

# ============================
# 准备日线数据（含MA20）
# ============================
if 'df_combined' not in globals():
    raise ValueError("请先加载 df_combined")

date_col = next((c for c in ['日期','date','trade_date','datetime'] if c in df_combined.columns), None)
code_col = next((c for c in ['代码','code','ts_code'] if c in df_combined.columns), None)
close_col = next((c for c in ['收盘价','close'] if c in df_combined.columns), None)
if not date_col or not code_col or not close_col:
    raise KeyError("日线数据缺少必要列")

df_daily = df_combined[[date_col, code_col, close_col]].copy()
df_daily.columns = ['date', 'code', 'close']
df_daily['date'] = pd.to_datetime(df_daily['date'])
df_daily['code'] = df_daily['code'].astype(str).str.zfill(6)
df_daily = df_daily.sort_values(['code', 'date']).reset_index(drop=True)

# 计算MA20（使用调仓日前一日数据）
df_daily['MA20'] = df_daily.groupby('code')['close'].transform(lambda x: x.rolling(20).mean().shift(1))

# ============================
# BaoStock 5分钟数据获取函数（单日，含重试）
# ============================
def to_bs_code(code):
    code = str(code).zfill(6)
    return f"sh.{code}" if code.startswith('6') else f"sz.{code}"

def fetch_5min_by_date(code, date_str, retries=3):
    bs_code = to_bs_code(code)
    for attempt in range(retries):
        try:
            rs = bs.query_history_k_data_plus(
                bs_code,
                "date,time,open,high,low,close,volume",
                start_date=date_str,
                end_date=date_str,
                frequency="5",
                adjustflag="3"
            )
            if rs.error_code == '0':
                data = rs.get_data()
                if len(data) > 0:
                    df = pd.DataFrame(data, columns=rs.fields)
                    df = df[df['date'].notna() & df['time'].notna()]
                    def parse_time(row):
                        time_str = str(row['time']).strip()
                        if len(time_str) >= 14:
                            return datetime.strptime(time_str[:14], "%Y%m%d%H%M%S")
                        else:
                            return pd.NaT
                    df['datetime'] = df.apply(parse_time, axis=1)
                    df = df.dropna(subset=['datetime'])
                    df = df[(df['datetime'].dt.hour >= 9) & (df['datetime'].dt.hour <= 15)]
                    df.rename(columns={'open':'开盘','high':'最高','low':'最低','close':'收盘','volume':'成交量'}, inplace=True)
                    for col in ['开盘','最高','最低','收盘','成交量']:
                        df[col] = df[col].astype(float)
                    df['ts_code'] = str(code).zfill(6)
                    df['trade_date'] = date_str
                    return df[['datetime', '开盘', '收盘', '最高', '最低', '成交量', 'ts_code', 'trade_date']]
            else:
                print(f"查询失败 {code} {date_str}: {rs.error_msg}")
        except Exception as e:
            print(f"获取异常 {code} {date_str}: {e}")
        if attempt < retries - 1:
            print(f"重试 {attempt+1}/{retries-1}...")
            time.sleep(RETRY_DELAY)
    return pd.DataFrame()

# ============================
# 缓存功能：保存/读取单日数据
# ============================
def get_cache_path(code, date_str):
    return os.path.join(CACHE_DIR, f"{code}_{date_str}.parquet")

def is_cached(code, date_str):
    path = get_cache_path(code, date_str)
    return os.path.exists(path) and os.path.getsize(path) > 0

def load_from_cache(code, date_str):
    try:
        return pd.read_parquet(get_cache_path(code, date_str))
    except Exception as e:
        print(f"读取缓存失败 {code} {date_str}: {e}")
        return pd.DataFrame()

def save_to_cache(df, code, date_str):
    if df.empty:
        return
    os.makedirs(CACHE_DIR, exist_ok=True)
    path = get_cache_path(code, date_str)
    try:
        df.to_parquet(path, index=False, engine='pyarrow')
    except Exception as e:
        print(f"保存缓存失败 {path}: {e}")

# ============================
# 收集所有需要的数据对，并检查缓存
# ============================
all_required_pairs = set()
for plan in plans:
    rebalance_date = pd.to_datetime(plan['调仓日期'])
    stocks = plan['股票明细']
    for stock in stocks:
        code = stock['代码']
        daily_stock = df_daily[df_daily['code'] == code].sort_values('date')
        future_daily = daily_stock[daily_stock['date'] > rebalance_date].head(HOLD_DAYS)
        if len(future_daily) < HOLD_DAYS:
            continue
        for date in future_daily['date']:
            date_str = date.strftime('%Y-%m-%d')
            all_required_pairs.add((code, date_str))

print(f"总共需要 (股票, 日期) 对: {len(all_required_pairs)}")

# 统计已缓存和未缓存
cached_pairs = {(c, d) for c, d in all_required_pairs if is_cached(c, d)}
missing_pairs = all_required_pairs - cached_pairs
print(f"已缓存: {len(cached_pairs)} 对")
print(f"需要获取: {len(missing_pairs)} 对")

# ============================
# 按需获取缺失数据
# ============================
bs.login()
print("Baostock 登录成功")

try:
    # 已有缓存数据汇总
    cached_df_list = []
    for code, date_str in cached_pairs:
        df_tmp = load_from_cache(code, date_str)
        if not df_tmp.empty:
            cached_df_list.append(df_tmp)
        else:
            # 缓存可能损坏，重新加入缺失列表
            missing_pairs.add((code, date_str))

    # 获取缺失数据
    total_missing = len(missing_pairs)
    for idx, (code, date_str) in enumerate(missing_pairs, 1):
        print(f"获取 {code} {date_str} ({idx}/{total_missing})")
        df_tmp = fetch_5min_by_date(code, date_str)
        if not df_tmp.empty:
            save_to_cache(df_tmp, code, date_str)
            cached_df_list.append(df_tmp)
        else:
            print(f"警告: 未能获取 {code} {date_str}")
        time.sleep(REQUEST_DELAY)
finally:
    bs.logout()
    print("Baostock 登出")

if not cached_df_list:
    print("没有可用的5分钟数据，无法回测。")
else:
    # 合并所有数据
    df_min_all = pd.concat(cached_df_list, ignore_index=True)
    print(f"合并后的5分钟数据记录数: {len(df_min_all)}")

    # ============================
    # 回测函数（5日持有，含MA20风控）
    # ============================
    def simulate_stock_trade_5min(code, rebalance_date):
        daily_stock = df_daily[df_daily['code'] == code].sort_values('date')
        if daily_stock.empty:
            return None

        prev_day = daily_stock[daily_stock['date'] <= rebalance_date].tail(1)
        if prev_day.empty:
            return None
        ma20_threshold = prev_day.iloc[0]['MA20']
        if pd.isna(ma20_threshold):
            ma20_threshold = None

        future_daily = daily_stock[daily_stock['date'] > rebalance_date].head(HOLD_DAYS)
        if len(future_daily) < HOLD_DAYS:
            return None
        future_dates = future_daily['date'].dt.strftime('%Y-%m-%d').tolist()

        min_data = df_min_all[(df_min_all['ts_code'] == code) & (df_min_all['trade_date'].isin(future_dates))].copy()
        if min_data.empty:
            return None
        min_data = min_data.sort_values('datetime')

        first_day_min = min_data[min_data['trade_date'] == future_dates[0]]
        if first_day_min.empty:
            return None
        buy_time = first_day_min.iloc[0]['datetime']
        buy_price = first_day_min.iloc[0]['开盘']

        sell_time = None
        sell_price = None

        if ma20_threshold is not None:
            after_buy = min_data[min_data['datetime'] > buy_time]
            for date_str in future_dates:
                day_min = after_buy[after_buy['trade_date'] == date_str]
                if day_min.empty:
                    continue
                trigger = day_min[day_min['收盘'] < ma20_threshold]
                if not trigger.empty:
                    sell_time = trigger.iloc[0]['datetime']
                    sell_price = trigger.iloc[0]['收盘']
                    break

        if sell_time is None:
            last_day_min = min_data[min_data['trade_date'] == future_dates[-1]]
            if last_day_min.empty:
                return None
            sell_time = last_day_min.iloc[-1]['datetime']
            sell_price = last_day_min.iloc[-1]['收盘']

        ret = (sell_price / buy_price - 1) * 100
        return {
            '买入时间': str(buy_time),
            '买入价格': round(buy_price, 2),
            '卖出时间': str(sell_time),
            '卖出价格': round(sell_price, 2),
            '收益(%)': round(ret, 2)
        }

    # ============================
    # 执行回测（应用仓位因子）
    # ============================
    period_results = []
    all_trades = []

    for plan in plans:
        rebalance_date = pd.to_datetime(plan['调仓日期'])
        position_factor = plan.get('仓位因子', 1.0)
        stocks = plan['股票明细']
        period_trades = []
        for stock in stocks:
            code = stock['代码']
            result = simulate_stock_trade_5min(code, rebalance_date)
            if result is not None:
                period_trades.append({'代码': code, '名称': stock.get('名称', ''), **result})
        if not period_trades:
            continue
        period_ret = np.mean([t['收益(%)'] for t in period_trades])
        period_ret_adjusted = period_ret * position_factor
        period_results.append({
            '调仓日期': plan['调仓日期'],
            '仓位因子': position_factor,
            '股票数量': len(period_trades),
            '原始组合收益(%)': period_ret,
            '调整后组合收益(%)': period_ret_adjusted,
            '股票明细': period_trades
        })
        all_trades.extend(period_trades)

    # ============================
    # 绩效汇总
    # ============================
    if not period_results:
        print("没有成功回测的交易。")
    else:
        period_df = pd.DataFrame(period_results)
        period_df['净值'] = (1 + period_df['调整后组合收益(%)'] / 100).cumprod()

        total_return = (period_df['净值'].iloc[-1] - 1) * 100
        n_periods = len(period_df)
        annual_return = (period_df['净值'].iloc[-1] ** (252 / (n_periods * HOLD_DAYS)) - 1) * 100 if n_periods > 0 else 0
        max_drawdown = ((period_df['净值'] / period_df['净值'].cummax()) - 1).min() * 100
        sharpe = (period_df['调整后组合收益(%)'].mean() / period_df['调整后组合收益(%)'].std()) * np.sqrt(252 / HOLD_DAYS) if period_df['调整后组合收益(%)'].std() > 0 else np.nan
        win_rate = (period_df['调整后组合收益(%)'] > 0).mean() * 100

        print("\n===== 5日周期回测绩效（含MA20风控 + 动态仓位） =====")
        print(f"总收益率: {total_return:.2f}%")
        print(f"年化收益率: {annual_return:.2f}%")
        print(f"最大回撤: {max_drawdown:.2f}%")
        print(f"夏普比率(每{HOLD_DAYS}日): {sharpe:.2f}")
        print(f"胜率: {win_rate:.2f}%")

        result_output = {
            "回测说明": "5日周期，基于unique_date_code_pairs，等权纳入所有标的，买入次日开盘，持有期内5分钟收盘价跌破MA20则卖出，否则持有5日。每期仓位根据基础模型风控因子动态调整。",
            "调仓周期数": len(period_df),
            "绩效指标": {
                "总收益率(%)": round(total_return, 2),
                "年化收益率(%)": round(annual_return, 2),
                "最大回撤(%)": round(max_drawdown, 2),
                "夏普比率": round(sharpe, 2) if pd.notna(sharpe) else None,
                "胜率(%)": round(win_rate, 2)
            },
            "调仓周期明细": period_df[['调仓日期', '仓位因子', '股票数量', '原始组合收益(%)', '调整后组合收益(%)', '净值']].to_dict('records'),
            "所有交易明细": all_trades
        }

        # 动态生成文件名
        if period_df is not None and not period_df.empty:
            plan_dates = [pd.to_datetime(plan['调仓日期']) for plan in plans]
            min_date = min(plan_dates)
            max_date = max(plan_dates)
            date_range_str = f"{min_date.strftime('%Y%m')}_{max_date.strftime('%Y%m')}"
            output_filename = f"5日周期交易计划_{date_range_str}_回测结果.json"
        else:
            output_filename = "5日周期交易计划_回测结果.json"

        with open(output_filename, 'w', encoding='utf-8') as f:
            json.dump(result_output, f, ensure_ascii=False, indent=2, default=str)
        print(f"\n回测结果已保存至 {output_filename}")

        import matplotlib.pyplot as plt
        plt.figure(figsize=(10, 5))
        plt.plot(period_df['调仓日期'], period_df['净值'], marker='o')
        plt.title('Portfolio Net Value (5-day Cycle, All Stocks Equal Weight)')
        plt.xlabel('Rebalance Date')
        plt.ylabel('Net Value')
        plt.grid(True)
        plt.show()


# @title Commit Model JSONs to GitHub AIPEQModel (Tradetest dir)
import os
import glob
import shutil
import subprocess

# =========================
# 配置信息
# =========================
GIT_USERNAME = "digital-era"
GIT_EMAIL = "digital_era@sina.com"
GIT_REPO_NAME = "AIPEQModel"

GIT_TARGET_BRANCH = "main"          # 若为 master 请修改
GIT_PAT = ""        # ⚠️ 请替换为你的 PAT

GIT_TARGET_DIR = "Tradetest"        # 目标目录（仓库内的子目录）

repo_directory = f'/content/{GIT_REPO_NAME}'
search_directory = '/content/'
file_prefixes = ['10日周期交易计划_', '5日周期交易计划_']   # 注意后缀是下划线 + 日期

# =========================
# 1. 克隆仓库（如果本地不存在）
# =========================
if not os.path.exists(repo_directory):
    print(f"🚀 克隆仓库 {GIT_REPO_NAME} ...")
    clone_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
    result = subprocess.run(['git', 'clone', clone_url, repo_directory],
                            capture_output=True, text=True)
    if result.returncode != 0:
        print("克隆失败：", result.stderr)
        raise SystemExit
else:
    print(f"📁 仓库已存在，使用本地目录：{repo_directory}")

# =========================
# 2. 拉取最新代码（避免冲突）
# =========================
os.chdir(repo_directory)
print("拉取远程最新代码...")
subprocess.run(['git', 'pull'], capture_output=True, text=True)

# =========================
# 3. 创建目标目录（如果不存在）
# =========================
target_dir = os.path.join(repo_directory, GIT_TARGET_DIR)
os.makedirs(target_dir, exist_ok=True)
print(f"📂 目标目录：{target_dir}")

# =========================
# 4. 搜索所有匹配的 JSON 文件
# =========================
print(f"在 {search_directory} 中搜索模型 JSON 文件...")
source_files = []
for prefix in file_prefixes:
    pattern = os.path.join(search_directory, f"{prefix}*.json")
    source_files.extend(glob.glob(pattern))

if not source_files:
    print("⚠️ 未找到任何匹配的 JSON 文件，但将继续强制提交（空提交）。")
else:
    print(f"找到 {len(source_files)} 个 JSON 文件：")
    for f in source_files:
        print(f"  - {os.path.basename(f)}")

    # =========================
    # 5. 复制文件到目标目录
    # =========================
    print(f"\n复制文件到 {GIT_TARGET_DIR}/ ...")
    for src in source_files:
        dst = os.path.join(target_dir, os.path.basename(src))
        shutil.copy2(src, dst)
        print(f"  ✅ 复制 {os.path.basename(src)}")

# =========================
# 6. 设置 git 用户信息
# =========================
subprocess.run(['git', 'config', 'user.name', GIT_USERNAME], check=True)
subprocess.run(['git', 'config', 'user.email', GIT_EMAIL], check=True)

# =========================
# 7. 添加目标目录下的所有文件
# =========================
# 使用完整路径添加，避免影响其他目录
subprocess.run(['git', 'add', GIT_TARGET_DIR], check=True)
print(f"✅ 已添加 {GIT_TARGET_DIR}/ 下的文件")

# 无论是否有变更，都执行提交（使用 --allow-empty 确保空提交也能成功）
commit_message = f"Add trade plan JSON files to {GIT_TARGET_DIR} - force commit"
print("提交中（强制空提交）...")
subprocess.run(['git', 'commit', '--allow-empty', '-m', commit_message], check=True)
print("✅ 已提交本地 commit")

# =========================
# 8. 推送
# =========================
push_url = f'https://{GIT_PAT}@github.com/{GIT_USERNAME}/{GIT_REPO_NAME}.git'
print("推送中...")
result = subprocess.run(['git', 'push', push_url, GIT_TARGET_BRANCH],
                        capture_output=True, text=True)
if result.returncode != 0:
    print("推送失败，错误信息：")
    print(result.stderr)
    # 尝试 master 分支
    print("尝试 master 分支...")
    result2 = subprocess.run(['git', 'push', push_url, 'master'],
                             capture_output=True, text=True)
    if result2.returncode != 0:
        print("master 分支也失败：", result2.stderr)
    else:
        print("✅ 推送成功（master 分支）")
else:
    print("✅ 推送成功（main 分支）")

print("\n🏁 任务完成。")
