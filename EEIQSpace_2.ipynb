#@title 模型多因子分析（含介入时机过滤）
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
import warnings
from scipy import stats
from sklearn.preprocessing import StandardScaler

warnings.filterwarnings('ignore')
plt.rcParams['font.sans-serif'] = ['DejaVu Sans']
plt.rcParams['axes.unicode_minus'] = False

# ==============================================
# 1. 在 df_combined 上计算技术指标
# ==============================================
def compute_technical_indicators(df):
    df = df.sort_values(['代码','日期']).copy()
    # 累计涨幅
    df['5日累计涨幅'] = df.groupby('代码')['收盘价'].pct_change(5) * 100
    df['10日累计涨幅'] = df.groupby('代码')['收盘价'].pct_change(10) * 100

    # RSI(14)
    def rsi(series, period=14):
        delta = series.diff()
        gain = delta.clip(lower=0)
        loss = -delta.clip(upper=0)
        avg_gain = gain.rolling(window=period, min_periods=period).mean()
        avg_loss = loss.rolling(window=period, min_periods=period).mean()
        rs = avg_gain / avg_loss.replace(0, np.nan)  # 防止除以0
        rsi = 100 - (100 / (1 + rs))
        return rsi
    df['RSI14'] = df.groupby('代码')['收盘价'].transform(lambda x: rsi(x))

    # BIAS20
    df['MA20'] = df.groupby('代码')['收盘价'].rolling(20).mean().reset_index(level=0, drop=True)
    df['BIAS20'] = (df['收盘价'] / df['MA20'] - 1) * 100

    return df

print("计算技术指标...")
df_combined_tech = compute_technical_indicators(df_combined)
print("技术指标计算完成。")

# ==============================================
# 2. 合并 rank_df 与特征
# ==============================================
# 统一格式
df_combined_tech['日期'] = pd.to_datetime(df_combined_tech['日期']).dt.normalize()
df_combined_tech['代码'] = df_combined_tech['代码'].astype(str).str.zfill(6)

rank_df['中心日期'] = pd.to_datetime(rank_df['中心日期'])
rank_df['代码'] = rank_df['代码'].astype(str).str.zfill(6)

feature_cols = [
    '代码', '日期', 'PotScore', '总净流入占比_5日总和',
    '主力净流入-净占比', '超大单净流入-净占比',
    '涨跌幅', '收盘价', '5日累计涨幅', '10日累计涨幅', 'RSI14', 'BIAS20'
]
df_features = df_combined_tech[feature_cols].copy()

merged_df = rank_df.merge(
    df_features,
    left_on=['中心日期', '代码'],
    right_on=['日期', '代码'],
    how='left',
    suffixes=('', '_model')
)

print(f"Total records in rank_df: {len(rank_df)}")
print(f"Records after merge: {len(merged_df)}")
print(f"Missing PotScore: {merged_df['PotScore'].isna().sum()}")
print(f"Missing RSI14: {merged_df['RSI14'].isna().sum()}")
print(f"Missing BIAS20: {merged_df['BIAS20'].isna().sum()}")

# 删除关键特征缺失的样本（新因子允许缺失，但可先保留，后续过滤时处理）
merged_df = merged_df.dropna(subset=['PotScore', '总净流入占比_5日总和',
                                     '主力净流入-净占比', '超大单净流入-净占比'])
print(f"Records after dropping missing base features: {len(merged_df)}")

# ==============================================
# 3. 单因子分析（含新因子）
# ==============================================
def factor_analysis(df, factor, target='10天涨跌幅(%)', bins=5):
    df_temp = df[[factor, target]].dropna()
    if len(df_temp) < 20:
        return pd.DataFrame()
    df_temp['factor_bin'] = pd.qcut(df_temp[factor], q=bins, duplicates='drop')
    grouped = df_temp.groupby('factor_bin', observed=False).agg(
        count=(target, 'count'),
        mean_return=(target, 'mean'),
        median_return=(target, 'median'),
        win_rate=(target, lambda x: (x > 0).mean() * 100)
    ).reset_index()
    return grouped

all_factors = [
    'PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比',
    '涨跌幅', '5日累计涨幅', '10日累计涨幅', 'RSI14', 'BIAS20'
]

print("\n===== 单因子分析 =====")
for factor in all_factors:
    print(f"\n--- Factor: {factor} ---")
    result = factor_analysis(merged_df, factor)
    if not result.empty:
        print(result.round(2))
    else:
        print("样本不足，跳过。")

# ==============================================
# 4. 基础阈值网格搜索（资金流因子）
# ==============================================
print("\n===== Step 4: Base threshold search (fund flow factors) =====")

potscore_thresholds = [0.3, 0.5, 0.7, 1.0]
flow_5day_thresholds = [50, 60, 70, 80]
main_flow_thresholds = [0, 1, 2, 3]
super_flow_thresholds = [-5, -2, 0, 2]

best_base_score = -np.inf
best_base_params = {}
base_results = []

for pot_th in potscore_thresholds:
    for flow_th in flow_5day_thresholds:
        for main_th in main_flow_thresholds:
            for super_th in super_flow_thresholds:
                filtered = merged_df[
                    (merged_df['PotScore'] >= pot_th) &
                    (merged_df['总净流入占比_5日总和'] >= flow_th) &
                    (merged_df['主力净流入-净占比'] >= main_th) &
                    (merged_df['超大单净流入-净占比'] >= super_th)
                ]
                if len(filtered) < 20:
                    continue
                mean_ret = filtered['10天涨跌幅(%)'].mean()
                std_ret = filtered['10天涨跌幅(%)'].std()
                sharpe = mean_ret / std_ret if std_ret > 0 else 0
                win_rate = (filtered['10天涨跌幅(%)'] > 0).mean() * 100

                base_results.append({
                    'PotScore_min': pot_th,
                    'Flow5_min': flow_th,
                    'MainFlow_min': main_th,
                    'SuperFlow_min': super_th,
                    'n_samples': len(filtered),
                    'mean_return': mean_ret,
                    'win_rate': win_rate,
                    'std': std_ret,
                    'sharpe': sharpe
                })

                # 更新最优参数：优先考虑样本量>=50，若没有则退而求其次
                if len(filtered) >= 50:
                    if sharpe > best_base_score:
                        best_base_score = sharpe
                        best_base_params = {
                            'pot_th': pot_th,
                            'flow_th': flow_th,
                            'main_th': main_th,
                            'super_th': super_th,
                            'n_samples': len(filtered),
                            'mean_ret': mean_ret,
                            'win_rate': win_rate,
                            'sharpe': sharpe
                        }

# 如果没有找到样本量>=50的参数，则从所有结果中选择样本量最大且夏普最高的组合
if not best_base_params and base_results:
    base_results_df = pd.DataFrame(base_results)
    # 按样本量降序、夏普降序排序，取第一个
    base_results_df = base_results_df.sort_values(['n_samples', 'sharpe'], ascending=[False, False])
    best_row = base_results_df.iloc[0]
    best_base_params = {
        'pot_th': best_row['PotScore_min'],
        'flow_th': best_row['Flow5_min'],
        'main_th': best_row['MainFlow_min'],
        'super_th': best_row['SuperFlow_min'],
        'n_samples': int(best_row['n_samples']),
        'mean_ret': best_row['mean_return'],
        'win_rate': best_row['win_rate'],
        'sharpe': best_row['sharpe']
    }
    print("警告：没有参数组合满足样本量>=50，已回退选择样本量最大的最优组合。")
    print(f"选择的组合：{best_base_params}")
elif not best_base_params:
    # 极端情况：连一个结果都没有（不可能，但保留）
    best_base_params = {
        'pot_th': 0.3,
        'flow_th': 50,
        'main_th': 0,
        'super_th': -5,
        'n_samples': 0,
        'mean_ret': 0,
        'win_rate': 0,
        'sharpe': 0
    }
    print("警告：无任何有效组合，使用默认宽松过滤。")

print("\n最终使用的基础过滤参数：")
print(best_base_params)

# ==============================================
# 5. 介入时机过滤阈值搜索（在最佳基础参数上）
# ==============================================
print("\n===== Step 5: Timing filter search =====")

# ...（后续代码保持不变）

# ==============================================
# 5. 介入时机过滤阈值搜索（在最佳基础参数上）
# ==============================================
print("\n===== Step 5: Timing filter search =====")

# 定义候选阈值范围（放宽上限，避免过度过滤）
daily_change_upper = [5, 7, 9, 12]           # 当日涨跌幅上限
five_day_upper = [15, 20, 25, 30]            # 5日累计涨幅上限
ten_day_upper = [25, 30, 40, 50]             # 10日累计涨幅上限
rsi_upper = [70, 75, 80, 85]                 # RSI14上限
bias_upper = [10, 15, 20, 25]                # BIAS20上限

# 应用基础过滤（不考虑新因子）
base_filtered = merged_df[
    (merged_df['PotScore'] >= best_base_params['pot_th']) &
    (merged_df['总净流入占比_5日总和'] >= best_base_params['flow_th']) &
    (merged_df['主力净流入-净占比'] >= best_base_params['main_th']) &
    (merged_df['超大单净流入-净占比'] >= best_base_params['super_th'])
].copy()

print(f"Samples after base filter: {len(base_filtered)}")

# 对于新因子，将缺失值填充为极大值（视为满足条件），或直接删除，这里选择删除但记录数量
# 我们将在循环内对每个组合使用 dropna 并检查样本量

best_final_score = -np.inf
best_final_params = {}
final_results = []

for dc in daily_change_upper:
    for fd in five_day_upper:
        for td in ten_day_upper:
            for rsi in rsi_upper:
                for bias in bias_upper:
                    filtered = base_filtered[
                        (base_filtered['涨跌幅'] <= dc) &
                        (base_filtered['5日累计涨幅'] <= fd) &
                        (base_filtered['10日累计涨幅'] <= td) &
                        (base_filtered['RSI14'] <= rsi) &
                        (base_filtered['BIAS20'] <= bias)
                    ].dropna(subset=['5日累计涨幅', '10日累计涨幅', 'RSI14', 'BIAS20'])

                    if len(filtered) < 20:  # 最小样本要求降为20
                        continue

                    mean_ret = filtered['10天涨跌幅(%)'].mean()
                    std_ret = filtered['10天涨跌幅(%)'].std()
                    sharpe = mean_ret / std_ret if std_ret > 0 else 0
                    win_rate = (filtered['10天涨跌幅(%)'] > 0).mean() * 100

                    final_results.append({
                        'daily_change_upper': dc,
                        'five_day_upper': fd,
                        'ten_day_upper': td,
                        'rsi_upper': rsi,
                        'bias_upper': bias,
                        'n_samples': len(filtered),
                        'mean_return': mean_ret,
                        'win_rate': win_rate,
                        'std': std_ret,
                        'sharpe': sharpe
                    })

                    if sharpe > best_final_score and len(filtered) >= 30:
                        best_final_score = sharpe
                        best_final_params = {
                            'daily_change_upper': dc,
                            'five_day_upper': fd,
                            'ten_day_upper': td,
                            'rsi_upper': rsi,
                            'bias_upper': bias,
                            'n_samples': len(filtered),
                            'mean_ret': mean_ret,
                            'win_rate': win_rate,
                            'sharpe': sharpe
                        }

if final_results:
    final_results_df = pd.DataFrame(final_results).sort_values('sharpe', ascending=False)
    print("Top 10 final parameter combinations:")
    print(final_results_df.head(10))
    print("\nBest timing filter parameters:")
    print(best_final_params)
else:
    print("\n警告：没有找到满足样本要求的介入时机过滤参数组合。")
    print("可能原因：新因子缺失值过多或过滤过严。")
    print("将使用宽松默认值（不进行时机过滤）。")
    best_final_params = {
        'daily_change_upper': np.inf,
        'five_day_upper': np.inf,
        'ten_day_upper': np.inf,
        'rsi_upper': np.inf,
        'bias_upper': np.inf
    }

# 合并最终过滤条件
final_filter_params = {
    **best_base_params,
    **best_final_params
}
print("\n===== Final Filter Parameters =====")
print(final_filter_params)

# ==============================================
# 6. 基于最终过滤条件构建打分模型
# ==============================================
print("\n===== Step 6: Build scoring model with final filter =====")

final_filtered = merged_df[
    (merged_df['PotScore'] >= final_filter_params['pot_th']) &
    (merged_df['总净流入占比_5日总和'] >= final_filter_params['flow_th']) &
    (merged_df['主力净流入-净占比'] >= final_filter_params['main_th']) &
    (merged_df['超大单净流入-净占比'] >= final_filter_params['super_th']) &
    (merged_df['涨跌幅'] <= final_filter_params['daily_change_upper']) &
    (merged_df['5日累计涨幅'] <= final_filter_params['five_day_upper']) &
    (merged_df['10日累计涨幅'] <= final_filter_params['ten_day_upper']) &
    (merged_df['RSI14'] <= final_filter_params['rsi_upper']) &
    (merged_df['BIAS20'] <= final_filter_params['bias_upper'])
].dropna(subset=['5日累计涨幅', '10日累计涨幅', 'RSI14', 'BIAS20']).copy()

print(f"Samples after final filter: {len(final_filtered)}")

# 打分特征仍使用资金流四因子（可保持不变）
scoring_features = ['PotScore', '总净流入占比_5日总和', '主力净流入-净占比', '超大单净流入-净占比']
scaler = StandardScaler()
final_filtered[scoring_features] = scaler.fit_transform(final_filtered[scoring_features])

weights = {
    'PotScore': 0.4,
    '总净流入占比_5日总和': 0.3,
    '主力净流入-净占比': 0.2,
    '超大单净流入-净占比': 0.1
}
final_filtered['Score'] = sum(final_filtered[col] * w for col, w in weights.items())

# 得分分位组验证
final_filtered['score_bin'] = pd.qcut(final_filtered['Score'], q=5, duplicates='drop')
score_grouped = final_filtered.groupby('score_bin', observed=False)['10天涨跌幅(%)'].agg(['mean', 'std', 'count'])
score_grouped['win_rate'] = final_filtered.groupby('score_bin', observed=False)['10天涨跌幅(%)'].apply(lambda x: (x>0).mean()*100)
print("\nReturns by score quintile (after final filter):")
print(score_grouped.round(2))

# ==============================================
# 7. 固定调仓周期回测（使用最终过滤和打分）
# ==============================================
print("\n===== Step 7: Backtest (Fixed 10-day Rebalance) =====")

backtest_df = final_filtered.sort_values('中心日期')
all_dates = sorted(backtest_df['中心日期'].unique())
REBALANCE_PERIOD = 10
selected_dates = all_dates[::REBALANCE_PERIOD]

portfolio_returns = []
for date in selected_dates:
    day_data = backtest_df[backtest_df['中心日期'] == date]
    if day_data.empty:
        continue
    top_stocks = day_data.nlargest(3, 'Score')
    period_return = top_stocks['10天涨跌幅(%)'].mean()
    portfolio_returns.append({
        '调仓日期': date,
        '10日组合收益(%)': period_return,
        '持仓股票': list(top_stocks['代码'])
    })

if portfolio_returns:
    period_df = pd.DataFrame(portfolio_returns)
    period_df['净值'] = (1 + period_df['10日组合收益(%)'] / 100).cumprod()

    print(f"调仓期数: {len(period_df)}")
    print(f"总收益率: {(period_df['净值'].iloc[-1] - 1) * 100:.2f}%")
    print(f"年化收益率: {((period_df['净值'].iloc[-1]) ** (252 / (len(period_df) * REBALANCE_PERIOD)) - 1) * 100:.2f}%")
    print(f"最大回撤: {((period_df['净值'] / period_df['净值'].cummax()) - 1).min() * 100:.2f}%")
    print(f"夏普比率(每期): {period_df['10日组合收益(%)'].mean() / period_df['10日组合收益(%)'].std() * np.sqrt(252/REBALANCE_PERIOD):.2f}")

    plt.figure(figsize=(10,6))
    plt.plot(period_df['调仓日期'], period_df['净值'], marker='o')
    plt.title('Portfolio Net Value (Final Filter)')
    plt.xlabel('Rebalance Date')
    plt.ylabel('Net Value')
    plt.grid(True)
    plt.show()
else:
    print("没有足够的调仓期数据。")
